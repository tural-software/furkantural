<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Chatural</title>
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var t = (saved === 'light' || saved === 'dark')
                    ? saved
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.dataset.theme = t;
            } catch (_) { document.documentElement.dataset.theme = 'dark'; }
        })();
    </script>
    @* İstemci loglama: yakalanmayan hataları erkenden yakalamak için en başta yüklenir. *@
    <script src="~/js/logger.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

    @* PWA — kurulabilir uygulama *@
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#0f1117" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chatural" />
</head>
<body>
    @RenderBody()

    <div id="toastBox" role="status" aria-live="polite">
        <div id="toastTitle"></div>
        <div id="toastMsg"></div>
    </div>

    <div id="pwaInstallBar" class="pwa-install-bar" hidden>
        <button type="button" id="pwaInstallBtn" class="pwa-install-btn">⬇ Uygulamayı yükle</button>
        <button type="button" id="pwaInstallClose" class="pwa-install-close" aria-label="Kapat" title="Kapat">✕</button>
    </div>

    @* PWA — yeni sürüm hazır olduğunda kullanıcı onaylı güncelleme *@
    <div id="pwaUpdateBar" class="pwa-install-bar pwa-update-bar" hidden>
        <button type="button" id="pwaUpdateBtn" class="pwa-install-btn">⟳ Yeni sürümü yükle</button>
        <button type="button" id="pwaUpdateClose" class="pwa-install-close" aria-label="Şimdi değil" title="Şimdi değil">✕</button>
    </div>

    @* Çerez bilgilendirme / onay modalı — tüm sayfalarda görünür *@
    <div id="consentOverlay" class="consent-overlay">
        <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consentTitle">
            <div class="consent-title" id="consentTitle">Çerez Bilgilendirmesi</div>
            <div class="consent-text">
                Chatural'ı kullanarak, hizmetin düzgün çalışması için gerekli tüm çerezleri kabul etmiş
                olursunuz. Ayrıntılar için <a asp-controller="Home" asp-action="Privacy">gizlilik politikamıza</a> bakabilirsiniz.
            </div>
            <div class="consent-actions">
                <button id="consentOk" type="button" class="btn-consent btn-consent-primary">Kabul et ve devam et</button>
            </div>
        </div>
    </div>

    <script src="~/js/ft-time.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/consent.js" asp-append-version="true"></script>

    @if (TempData["ToastMsg"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (window.showToast) {
                    showToast(
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastType"] as string) ?? "success")),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastTitle"] as string) ?? "")),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastMsg"] as string) ?? "")));
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
