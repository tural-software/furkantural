@{
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Chatural — arkadaşlarınızla gerçek zamanlı mesajlaşma ve görüntülü görüşme uygulaması.";
    // Özel sohbet uygulaması: varsayılan olarak indekslenmez; gerçek bir landing
    // sayfası için ViewData["Robots"] = "index, follow" ile override edilebilir.
    var robots = ViewData["Robots"] as string ?? "noindex, nofollow";
    var seoTitle = ViewData["Title"] as string ?? "Chatural";
    var pageTitle = seoTitle == "Chatural" ? "Chatural" : $"{seoTitle} - Chatural";
    // CSP nonce (Program.cs middleware'inde üretilir) — inline <script> blokları bununla çalışır.
    var nonce = Context.Items["csp-nonce"] as string;
    var appShell = (ViewData["Shell"] as string) == "app";
}
<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@robots" />
    <link rel="canonical" href="@canonical" />

    <meta property="og:site_name" content="Chatural" />
    <meta property="og:title" content="@seoTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@(siteUrl + "/img/og-image.png")" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@metaDescription" />
    <meta name="twitter:image" content="@(siteUrl + "/img/og-image.png")" />
    <script nonce="@nonce">
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var t = (saved === 'light' || saved === 'dark')
                    ? saved
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.dataset.theme = t;
            } catch (_) { document.documentElement.dataset.theme = 'dark'; }
        })();
    </script>
    @* İstemci loglama: yakalanmayan hataları erkenden yakalamak için en başta yüklenir. *@
    <script src="~/js/logger.js" asp-append-version="true"></script>
    @* Inter kendi sunucumuzdan (theme.css içindeki @@font-face, wwwroot/fonts). *@
    <link rel="preload" href="~/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#0f1117" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Chatural" />
</head>
<body>
    @await Html.PartialAsync("_TopBar")

    <div class="shell@(appShell ? " shell--app" : "")">
        @RenderBody()

        @if (!appShell)
        {
            @await Html.PartialAsync("_Footer")
        }
    </div>

    <div id="toastBox" role="status" aria-live="polite">
        <div id="toastTitle"></div>
        <div id="toastMsg"></div>
    </div>

    <div id="pwaInstallBar" class="pwa-install-bar" role="status" aria-live="polite" hidden>
        <button type="button" id="pwaInstallBtn" class="pwa-install-btn">
            <span aria-hidden="true">⬇</span> Uygulamayı yükle
        </button>
        <button type="button" id="pwaInstallClose" class="pwa-install-close" aria-label="Yükleme çubuğunu kapat" title="Kapat">
            <span aria-hidden="true">✕</span>
        </button>
    </div>

    @* Güncelleme çubuğu; yeni sürüm hazır olsa bile kullanıcı onaylamadan devralmaz (bkz. sw.js). *@
    <div id="pwaUpdateBar" class="pwa-install-bar pwa-update-bar" role="status" aria-live="polite" hidden>
        <button type="button" id="pwaUpdateBtn" class="pwa-install-btn">
            <span aria-hidden="true">⟳</span> Yeni sürümü yükle
        </button>
        <button type="button" id="pwaUpdateClose" class="pwa-install-close" aria-label="Güncellemeyi şimdi değil" title="Şimdi değil">
            <span aria-hidden="true">✕</span>
        </button>
    </div>

    @* Çerez onayı her sayfada görünür; yerleşimi _Layout dışına taşınırsa bazı sayfalarda kaybolur. *@
    <div id="consentOverlay" class="consent-overlay">
        <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="consentTitle">
            <div class="consent-title" id="consentTitle">Çerez Bilgilendirmesi</div>
            <div class="consent-text">
                Chatural'ı kullanarak, hizmetin düzgün çalışması için gerekli tüm çerezleri kabul etmiş
                olursunuz. Ayrıntılar için <a asp-controller="Home" asp-action="Privacy">gizlilik politikamıza</a> bakabilirsiniz.
            </div>
            <div class="consent-actions">
                <button id="consentOk" type="button" class="btn-consent btn-consent-primary">Kabul et ve devam et</button>
            </div>
        </div>
    </div>

    <script src="~/js/ft-time.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/consent.js" asp-append-version="true"></script>

    @if (TempData["ToastMsg"] != null)
    {
        <script nonce="@nonce">
            document.addEventListener('DOMContentLoaded', function () {
                if (window.showToast) {
                    showToast(
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastType"] as string) ?? "success")),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastTitle"] as string) ?? "")),
                        @Html.Raw(System.Text.Json.JsonSerializer.Serialize((TempData["ToastMsg"] as string) ?? "")));
                }
            });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
