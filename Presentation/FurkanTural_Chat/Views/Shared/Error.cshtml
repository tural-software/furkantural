@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<section class="status-wrap">
    <div class="status-icon" aria-hidden="true">!</div>

    <p class="status-kicker">Hata</p>

    <h1 class="status-title">İsteğiniz işlenirken bir hata oluştu</h1>

    <p class="status-text">
        Beklenmeyen bir sorun çıktı ve sayfa tamamlanamadı. Birazdan tekrar deneyebilir
        ya da ana sayfaya dönebilirsiniz.
    </p>

    <div class="status-actions">
        <a class="btn-primary status-btn" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
        <a class="btn-outline status-btn" asp-controller="Chat" asp-action="Index">Sohbete dön</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="status-request">
            <span class="status-request-label">Request ID</span>
            <span class="status-request-value">@Model.RequestId</span>
        </p>
    }
</section>
