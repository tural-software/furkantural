@model LoginRequestModel
@{
    ViewData["Title"] = "Giriş";
    ViewData["TopBarAction"] = "register";
    ViewData["AsideTitle"] = "Tekrar hoş geldiniz";
    ViewData["AsideText"] = "Sohbetleriniz kaldığı yerden devam ediyor. Giriş yapın; arkadaş listeniz ve mesajlarınız sizi bekliyor.";
}
<div class="auth-wrap">
    @await Html.PartialAsync("_AuthAside")

    <div class="auth-card">
        <div class="auth-brand">
            <img src="~/img/chatural-logo.png" alt="Chatural" class="auth-logo" width="56" height="56" />
            <div class="auth-name" aria-label="Chatural">Cha<span>tural</span></div>
        </div>
        <p class="auth-sub">Hesabınıza giriş yapın</p>

        <form id="loginForm" asp-action="Login" method="post" class="auth-form"
              data-auth-form data-fail-title="Giriş başarısız"
              novalidate aria-label="Giriş formu">
            @Html.AntiForgeryToken()

            <label asp-for="Username">Kullanıcı adı</label>
            <input asp-for="Username" autocomplete="username" autofocus
                   aria-required="true" aria-describedby="username-err" />
            <span asp-validation-for="Username" class="field-error" id="username-err" role="alert"></span>

            <label asp-for="Password">Şifre</label>
            <input asp-for="Password" type="password" autocomplete="current-password"
                   aria-required="true" aria-describedby="password-err" />
            <span asp-validation-for="Password" class="field-error" id="password-err" role="alert"></span>

            @if (!string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string))
            {
                <div class="cf-turnstile" data-sitekey="@ViewBag.TurnstileSiteKey"
                     data-callback="onTurnstileSuccess"
                     data-expired-callback="onTurnstileExpired"
                     data-error-callback="onTurnstileError"></div>
            }
            <input type="hidden" name="TurnstileToken" id="turnstileToken" />
            <p class="field-error" id="turnstileHint" role="status" aria-live="polite">@(string.IsNullOrEmpty(ViewBag.TurnstileSiteKey as string) ? "Robot doğrulaması şu anda yüklenemiyor; giriş ve kayıt bu doğrulama olmadan tamamlanamaz." : "")</p>

            <button type="submit" class="btn-primary" data-loading-text="Giriş yapılıyor…"
                    disabled>Giriş yap</button>
        </form>

        <p class="auth-foot">Hesabın yok mu? <a asp-action="Register">Üye ol</a></p>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/turnstile-gate.js" asp-append-version="true"></script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
