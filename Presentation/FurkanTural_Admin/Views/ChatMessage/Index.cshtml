@using FurkanTural_Admin.Models.ChatMessage
@model ChatMessageIndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/pages/chat-message/chat-message-index.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.__apiBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((string)(ViewData["ApiBaseUrl"] ?? "")));
        window.__messageMeta = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            search        = Model.SearchContent ?? "",
            usernameFilter= Model.UsernameFilter ?? "",
            typeFilter    = Model.TypeFilter ?? "",
            activeFilter  = Model.ActiveFilter ?? "",
            deletedFilter = Model.DeletedFilter ?? "",
            dateFrom      = Model.DateFrom ?? "",
            dateTo        = Model.DateTo ?? "",
            pageNumber    = Model.PageNumber,
            pageSize      = Model.PageSize
        }));
    </script>
    <script src="~/js/detail-modal.js" asp-append-version="true"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/bulk-select.js" asp-append-version="true"></script>
    <script src="~/js/pages/chat-message-index.js" asp-append-version="true"></script>
}

@Html.AntiForgeryToken()

<div class="container">
    @await Html.PartialAsync("_Breadcrumb", "")

    <div class="pg-header">
        <div>
            @await Html.PartialAsync("_PageTitle")
            <p class="section-desc">Sohbet mesajlarını görüntüleyin ve denetleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index")" class="btn-outline">@await Html.PartialAsync("_Icons", "refresh") Yenile</a>
            <a href="@Url.Action("TableDetail")" class="btn-outline">@await Html.PartialAsync("_Icons", "table-icon") Tablo Detayları</a>
        </div>
    </div>

    <div class="stats-row">
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--total">@await Html.PartialAsync("_Icons", "messages")</div>
            <div><p class="stat-box__label">Toplam</p><div class="stat-box__value">@Model.TotalCount.ToString("N0")</div><span class="stat-box__unit">mesaj</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--active">@await Html.PartialAsync("_Icons", "check-circle")</div>
            <div><p class="stat-box__label">Aktif</p><div class="stat-box__value">@Model.ActiveCount.ToString("N0")</div><span class="stat-box__unit">mesaj</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--passive">@await Html.PartialAsync("_Icons", "x-circle")</div>
            <div><p class="stat-box__label">Pasif</p><div class="stat-box__value">@Model.PassiveCount.ToString("N0")</div><span class="stat-box__unit">mesaj</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--deleted">@await Html.PartialAsync("_Icons", "trash")</div>
            <div><p class="stat-box__label">Silinmiş</p><div class="stat-box__value">@Model.DeletedCount.ToString("N0")</div><span class="stat-box__unit">mesaj</span></div>
        </div>
    </div>

    <div class="card" style="padding: 1.25rem; margin-bottom: 1.25rem;">
        <form method="get" action="@Url.Action("Index")">
            <div class="filter-bar">
                <div class="filter-group">
                    <label>İçerik ara</label>
                    <div class="filter-input-wrap">
                        @await Html.PartialAsync("_Icons", "search")
                        <input aria-label="İçerik ara" type="text" name="search" value="@Model.SearchContent" class="filter-input filter-input--search" placeholder="İçerik araması şifreli mesajlarda kullanılamaz" title="Mesaj içerikleri şifreli saklanır; sunucu tarafında içerik araması yapılamaz. Kullanıcı adı, tür ve tarihle süzün." disabled />
                    </div>
                </div>
                <div class="filter-group">
                    <label>Kullanıcı adı</label>
                    <div class="filter-input-wrap">
                        @await Html.PartialAsync("_Icons", "user")
                        <input aria-label="Kullanıcı adı" type="text" name="usernameFilter" value="@Model.UsernameFilter" class="filter-input filter-input--search" placeholder="Gönderen/alıcı kullanıcı adı..." />
                    </div>
                </div>
                <div class="filter-group">
                    <label>Tür</label>
                    <select aria-label="Tür" name="typeFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.TypeFilter))">Tümü</option>
                        <option value="Text" selected="@(Model.TypeFilter == "Text")">Metin</option>
                        <option value="Audio" selected="@(Model.TypeFilter == "Audio")">Ses Kaydı</option>
                        <option value="Image" selected="@(Model.TypeFilter == "Image")">Görsel</option>
                        <option value="Video" selected="@(Model.TypeFilter == "Video")">Video</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Aktiflik Durumu</label>
                    <select aria-label="Aktiflik Durumu" name="activeFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.ActiveFilter))">Tümü</option>
                        <option value="active" selected="@(Model.ActiveFilter == "active")">Aktif</option>
                        <option value="passive" selected="@(Model.ActiveFilter == "passive")">Pasif</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Silinme Durumu</label>
                    <select aria-label="Silinme Durumu" name="deletedFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.DeletedFilter))">Tümü</option>
                        <option value="notDeleted" selected="@(Model.DeletedFilter == "notDeleted")">Silinmemiş</option>
                        <option value="deleted" selected="@(Model.DeletedFilter == "deleted")">Silinmiş</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Oluşturulma Tarihi</label>
                    <div class="filter-date-row">
                        <input aria-label="Oluşturulma Tarihi başlangıç" type="date" name="dateFrom" value="@Model.DateFrom" class="filter-input" />
                        <span class="filter-date-sep">→</span>
                        <input aria-label="Oluşturulma Tarihi bitiş" type="date" name="dateTo" value="@Model.DateTo" class="filter-input" />
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">@await Html.PartialAsync("_Icons", "filter-icon") Filtrele</button>
                    <a href="@Url.Action("Index")" class="btn-outline">@await Html.PartialAsync("_Icons", "x-mark") Temizle</a>
                </div>
            </div>
        </form>
    </div>

    <div class="card" id="message-table-card" style="padding: 0; overflow: hidden;">
        <div id="message-table-section">
            @await Html.PartialAsync("_ChatMessageTable", Model)
        </div>
    </div>
</div>
