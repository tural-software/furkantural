@using FurkanTural_Admin.Models.Project
@model ProjectIndexViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/pages/project/project-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/filter-blog-select.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.__projectMeta = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
            searchTitle     = Model.SearchTitle ?? "",
            completedFilter = Model.CompletedFilter ?? "",
            activeFilter    = Model.ActiveFilter ?? "",
            deletedFilter   = Model.DeletedFilter ?? "",
            projectId       = Model.ProjectIdFilter?.ToString() ?? "",
            dateFrom        = Model.DateFrom ?? "",
            dateTo          = Model.DateTo ?? "",
            pageNumber      = Model.PageNumber,
            pageSize        = Model.PageSize
        }));
    </script>
    <script src="~/js/detail-modal.js" asp-append-version="true"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/form-modal.js" asp-append-version="true"></script>
    <script src="~/js/filter-blog-select.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-detail.js" asp-append-version="true"></script>
}

@Html.AntiForgeryToken()

<div class="container">

    @await Html.PartialAsync("_Breadcrumb", "")

    <div class="pg-header">
        <div>
            @await Html.PartialAsync("_PageTitle")
            <p class="section-desc">Projeler tablosundaki kayıtları görüntüleyin, arayın ve yönetin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "refresh")
                Yenile
            </a>
            <a href="@Url.Action("TableDetail")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "table-icon")
                Tablo Detayları
            </a>
            <button type="button" id="project-add-btn" class="btn-primary">
                @await Html.PartialAsync("_Icons", "plus")
                Yeni Kayıt Ekle
            </button>
        </div>
    </div>

    <div class="stats-row">
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--total">
                @await Html.PartialAsync("_Icons", "projects")
            </div>
            <div>
                <p class="stat-box__label">Toplam Kayıt</p>
                <div class="stat-box__value">@Model.TotalCount.ToString("N0")</div>
                <span class="stat-box__unit">proje</span>
            </div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--active">
                @await Html.PartialAsync("_Icons", "check-circle")
            </div>
            <div>
                <p class="stat-box__label">Aktif Kayıt</p>
                <div class="stat-box__value">@Model.ActiveCount.ToString("N0")</div>
                <span class="stat-box__unit">proje</span>
            </div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--passive">
                @await Html.PartialAsync("_Icons", "x-circle")
            </div>
            <div>
                <p class="stat-box__label">Pasif Kayıt</p>
                <div class="stat-box__value">@Model.PassiveCount.ToString("N0")</div>
                <span class="stat-box__unit">proje</span>
            </div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--deleted">
                @await Html.PartialAsync("_Icons", "trash")
            </div>
            <div>
                <p class="stat-box__label">Silinmiş Kayıt</p>
                <div class="stat-box__value">@Model.DeletedCount.ToString("N0")</div>
                <span class="stat-box__unit">proje</span>
            </div>
        </div>
    </div>

    <div class="card" style="padding: 1.25rem; margin-bottom: 1.25rem;">
        <form method="get" action="@Url.Action("Index")">
            <div class="filter-bar">
                <div class="filter-group">
                    <label>Başlık Ara</label>
                    <div class="filter-input-wrap">
                        @await Html.PartialAsync("_Icons", "search")
                        <input type="text" name="searchTitle" value="@Model.SearchTitle"
                               class="filter-input filter-input--search"
                               placeholder="Proje başlığı ara..." />
                    </div>
                </div>
                <div class="filter-group">
                    <label>Tamamlanma Durumu</label>
                    <select aria-label="Tamamlanma Durumu" name="completedFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.CompletedFilter))">Tümü</option>
                        <option value="completed" selected="@(Model.CompletedFilter == "completed")">Tamamlandı</option>
                        <option value="notCompleted" selected="@(Model.CompletedFilter == "notCompleted")">Devam Ediyor</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Aktiflik Durumu</label>
                    <select aria-label="Aktiflik Durumu" name="activeFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.ActiveFilter))">Tümü</option>
                        <option value="active" selected="@(Model.ActiveFilter == "active")">Aktif</option>
                        <option value="passive" selected="@(Model.ActiveFilter == "passive")">Pasif</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Silinme Durumu</label>
                    <select aria-label="Silinme Durumu" name="deletedFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.DeletedFilter))">Tümü</option>
                        <option value="notDeleted" selected="@(Model.DeletedFilter == "notDeleted")">Silinmemiş</option>
                        <option value="deleted" selected="@(Model.DeletedFilter == "deleted")">Silinmiş</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Proje</label>
                    <div class="fbs-wrap"
                         data-fbs-endpoint="/Project/ProjectOptions"
                         data-fbs-initial="@(Model.ProjectIdFilter.HasValue ? Model.ProjectIdFilter.Value.ToString() : "")">
                        <input aria-label="Proje" type="text" class="fbs-search filter-input" autocomplete="off"
                               placeholder="Proje ara..." />
                        <input type="hidden" class="fbs-value" name="projectId" value="@Model.ProjectIdFilter" />
                        <div class="fbs-dropdown"></div>
                    </div>
                </div>
                <div class="filter-group">
                    <label>Oluşturulma Tarihi</label>
                    <div class="filter-date-row">
                        <input aria-label="Oluşturulma Tarihi başlangıç" type="date" name="dateFrom" value="@Model.DateFrom" class="filter-input" />
                        <span class="filter-date-sep">→</span>
                        <input aria-label="Oluşturulma Tarihi bitiş" type="date" name="dateTo" value="@Model.DateTo" class="filter-input" />
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">
                        @await Html.PartialAsync("_Icons", "filter-icon")
                        Filtrele
                    </button>
                    <a href="@Url.Action("Index")" class="btn-outline">
                        @await Html.PartialAsync("_Icons", "x-mark")
                        Temizle
                    </a>
                </div>
            </div>
        </form>
    </div>

    <div class="card" id="project-table-card" style="padding: 0; overflow: hidden;">
        <div id="project-table-section">
            @await Html.PartialAsync("_ProjectTable", Model)
        </div>
    </div>

</div>
