@{
    ViewData["Title"] = "Projects Tablosu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/project/project-index.css" asp-append-version="true" />
}

<div class="container">

    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <a href="@Url.Action("Index", "Project")">Projeler</a>
        <span class="bc__sep">›</span>
        <span>Tablo Detayları</span>
    </nav>

    <div class="pg-header">
        <div>
            <div class="pg-header__title-row">
                <h1 class="section-title" style="margin:0">Projects Tablosu</h1>
                <span class="page-badge">TABLO</span>
            </div>
            <p class="section-desc">Tablo yapısını görüntüleyin ve alan detaylarını inceleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index", "Project")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "arrow-left")
                Verilere Dön
            </a>
        </div>
    </div>

    <div class="schema-stats">
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "database")</div>
            <div class="schema-stat__label">Toplam Alan</div>
            <div class="schema-stat__value">15</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "field-key")</div>
            <div class="schema-stat__label">Primary Key</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "hash-icon")</div>
            <div class="schema-stat__label">Identity</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "link")</div>
            <div class="schema-stat__label">Foreign Key</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "lock-icon")</div>
            <div class="schema-stat__label">Zorunlu Alan</div>
            <div class="schema-stat__value">5</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">@await Html.PartialAsync("_Icons", "circle-outline")</div>
            <div class="schema-stat__label">Boş Geçilebilir</div>
            <div class="schema-stat__value">10</div>
            <div class="schema-stat__unit">alan</div>
        </div>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-field">Alan Adı</th>
                        <th>Veri Tipi</th>
                        <th>Maks. Uzunluk (Byte)</th>
                        <th>Boş Geçilebilir</th>
                        <th>Primary Key</th>
                        <th>Identity</th>
                        <th>Varsayılan</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="field-name field-name--pk">@await Html.PartialAsync("_Icons", "field-key") Id</span></td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td>Yok</td>
                        <td>Benzersiz proje tanımlayıcısı</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">Title</span></td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>1000</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Proje başlığı</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">Description</span></td>
                        <td><span class="type-tag">nvarchar(max)</span></td>
                        <td>-1</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Proje açıklaması</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">ShortDescription</span></td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>600</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Kısa açıklama</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">TechStack</span></td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>1000</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Kullanılan teknolojiler</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">GitHubUrl</span></td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>2000</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>GitHub deposu URL'si</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">DemoUrl</span></td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>2000</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Canlı demo URL'si</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">IsCompleted</span></td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>0</td>
                        <td>Proje tamamlanma durumu</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">IsActive</span></td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>1</td>
                        <td>Aktiflik durumu</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">IsDeleted</span></td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>0</td>
                        <td>Silinme durumu</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">CreatedAt</span></td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>Yok</td>
                        <td>Oluşturulma tarihi</td>
                    </tr>
                    <tr>
                        <td><span class="field-name field-name--fk">@await Html.PartialAsync("_Icons", "link") CreatedBy</span></td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Kaydı oluşturan kullanıcı (FK → Users.Id)</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">UpdatedAt</span></td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Son güncellenme tarihi</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">UpdatedBy</span></td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Kaydı güncelleyen kullanıcı</td>
                    </tr>
                    <tr>
                        <td><span class="field-name">DeletedAt</span></td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Silinme tarihi</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
