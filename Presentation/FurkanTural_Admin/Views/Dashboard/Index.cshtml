@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <div class="section-header reveal">
        <p class="section-eyebrow">Hoş Geldin</p>
        <h1 class="section-title">@ViewData["Username"]</h1>
        <p class="section-desc">Admin paneli iskeleti hazır. Modüller bu noktadan eklenecek.</p>
    </div>

    <div class="card reveal">
        <p style="margin:0; color: var(--text-dim);">Burası dashboard içeriği için ayrılmış alan. İlk modül buraya gelecek.</p>
    </div>
</div>
