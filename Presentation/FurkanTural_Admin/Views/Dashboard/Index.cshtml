@using FurkanTural_Admin.Models.Dashboard
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <div class="section-header reveal">
        <p class="section-eyebrow">Hoş Geldin</p>
        <h1 class="section-title">@Model.Username</h1>
        <p class="section-desc">Yönetebileceğin modüller aşağıda listelenmiştir. Bir kart üzerindeki "Yönet" butonu ile ilgili modülün CRUD sayfasına ulaşabilirsin.</p>
    </div>

    <div class="dashboard-grid">
        @foreach (var card in Model.Modules)
        {
            <partial name="_EntityCard" model="card" />
        }
    </div>
</div>
