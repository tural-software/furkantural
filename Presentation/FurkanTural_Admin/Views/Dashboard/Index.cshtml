@using FurkanTural_Admin.Models.Dashboard
@model DashboardViewModel
@{
    ViewData["Title"] = "Panel";
}

<div class="container">
    <div class="pg-header">
        <div>
            <h1 class="section-title">Panel</h1>
            <p class="section-desc">
                @Model.ModuleCount modül@(Model.TotalRecordCount.HasValue ? $" · {Model.TotalRecordCount.Value:N0} kayıt" : "")
                <span class="dash-hint">— modüller arasında <kbd>Ctrl</kbd>+<kbd>K</kbd> ile dolaşabilirsiniz.</span>
            </p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "refresh")
                Yenile
            </a>
        </div>
    </div>

    @if (Model.Kpis.Count > 0)
    {
        <section class="dash-kpis" aria-label="Özet göstergeler">
            @foreach (var kpi in Model.Kpis)
            {
                <article class="kpi" data-kpi="@kpi.Key">
                    <span class="kpi__label">@kpi.Label</span>
                    <span class="kpi__value-row">
                        @if (string.IsNullOrEmpty(kpi.Url))
                        {
                            <span class="kpi__value">@kpi.Value</span>
                        }
                        else
                        {
                            <a class="kpi__value kpi__value--link" href="@kpi.Url">@kpi.Value</a>
                        }
                        @if (kpi.Trend is { } trend)
                        {
                            var cls = trend > 0 ? "kpi__trend--up" : trend < 0 ? "kpi__trend--down" : "kpi__trend--flat";
                            var arrow = trend > 0 ? "▲" : trend < 0 ? "▼" : "▬";
                            <span class="kpi__trend @cls" title="@kpi.TrendText" aria-label="@(kpi.TrendText ?? "") · fark @(trend > 0 ? "+" : "")@trend">@arrow @Math.Abs(trend)</span>
                        }
                    </span>
                    @if (!string.IsNullOrEmpty(kpi.Detail))
                    {
                        <span class="kpi__detail">@kpi.Detail</span>
                    }
                </article>
            }
        </section>
    }

    @if (Model.Attention.Count > 0)
    {
        <section class="dash-attention" aria-labelledby="dash-attention-title">
            <h2 id="dash-attention-title" class="dash-attention__title">Dikkat gerektiren</h2>
            <ul class="dash-attention__list">
                @foreach (var item in Model.Attention)
                {
                    <li>
                        <a class="dash-attention__item" href="@item.Url">
                            <span class="dash-attention__count">@item.Count.ToString("N0")</span>
                            <span class="dash-attention__text">@item.Text</span>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }

    @foreach (var group in Model.Groups)
    {
        <section class="dash-group">
            <h2 class="dash-group__title">
                @group.Name
                <span class="dash-group__count">@group.Modules.Count</span>
            </h2>
            <div class="dashboard-grid">
                @foreach (var card in group.Modules)
                {
                    <partial name="_EntityCard" model="card" />
                }
            </div>
        </section>
    }
</div>
