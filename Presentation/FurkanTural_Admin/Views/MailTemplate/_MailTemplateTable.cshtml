@using FurkanTural_Admin.Models.MailTemplate
@using System.Text.Json
@model MailTemplateIndexViewModel
@{
    int rangeStart = Model.TotalFiltered > 0 ? (Model.PageNumber - 1) * Model.PageSize + 1 : 0;
    int rangeEnd   = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFiltered);

    string PageUrl(int p) => Url.Action("Index", new
    {
        name          = Model.SearchName,
        activeFilter  = Model.ActiveFilter,
        deletedFilter = Model.DeletedFilter,
        dateFrom      = Model.DateFrom,
        dateTo        = Model.DateTo,
        pageNumber    = p,
        pageSize      = Model.PageSize
    }) ?? "#";

    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<script id="__mail-template-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Ad</th>
                <th>Tip</th>
                <th>Proje</th>
                <th>Durum</th>
                <th>Tarih</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr class="@(row.IsDeleted ? "row--deleted" : "")">
                    <td class="col-id">@row.Id</td>
                    <td>@row.Name</td>
                    <td>
                        <span class="badge badge--primary">@(row.TypeName ?? row.TypeCode)</span>
                        @if (row.Placeholders.Count == 0)
                        {
                            <span class="badge badge--warning" title="Bu türü gönderen bir kod yolu yok">gönderilmiyor</span>
                        }
                    </td>
                    <td>
                        @if (row.AppSourceId.HasValue)
                        {
                            <span class="badge badge--primary">@(row.AppSourceName ?? row.AppSourceCode)</span>
                        }
                        else
                        {
                            <span class="badge badge--neutral">Genel</span>
                        }
                    </td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="badge badge--danger">Silinmiş</span>
                        }
                        else if (row.IsActive)
                        {
                            <span class="badge badge--success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge badge--secondary">Pasif</span>
                        }
                    </td>
                    <td>@row.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="col-actions">
                        <div class="row-actions">
                            <button type="button" class="row-btn ft-view-btn"
                                    data-id="@row.Id"
                                    title="Görüntüle">
                                @await Html.PartialAsync("_Icons", "eye")
                            </button>
                            @if (!row.IsDeleted && row.IsActive)
                            {
                                <button type="button" class="row-btn row-btn--edit ft-edit-btn"
                                        data-id="@row.Id"
                                        title="Düzenle">
                                    @await Html.PartialAsync("_Icons", "pencil")
                                </button>
                            }
                            @if (!row.IsDeleted)
                            {
                                if (row.IsActive)
                                {
                                    <form method="post" action="@Url.Action("ToggleActive", "MailTemplate")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--warn" title="Pasif Yap">
                                            @await Html.PartialAsync("_Icons", "toggle-on")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("ToggleActive", "MailTemplate")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--success" title="Aktif Yap">
                                            @await Html.PartialAsync("_Icons", "toggle-off")
                                        </button>
                                    </form>
                                }
                                <form method="post" action="@Url.Action("Delete", "MailTemplate")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--delete" title="Sil">
                                        @await Html.PartialAsync("_Icons", "trash")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("Restore", "MailTemplate")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--restore" title="Geri Yükle">
                                        @await Html.PartialAsync("_Icons", "restore")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row">
                    <td colspan="7">Kayıt bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="tbl-footer">
    <div class="tbl-footer__left">
        <form method="get" action="@Url.Action("Index")" id="pageSizeForm">
            <input type="hidden" name="name"          value="@Model.SearchName" />
            <input type="hidden" name="activeFilter"  value="@Model.ActiveFilter" />
            <input type="hidden" name="deletedFilter" value="@Model.DeletedFilter" />
            <input type="hidden" name="dateFrom"      value="@Model.DateFrom" />
            <input type="hidden" name="dateTo"        value="@Model.DateTo" />
            <input type="hidden" name="pageNumber"    value="1" />
            Sayfa başına
            <select name="pageSize" class="page-size-sel" onchange="this.form.submit()">
                @foreach (var s in new[] { 10, 25, 50, 100 })
                {
                    <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                }
            </select>
            kayıt gösteriliyor
        </form>
    </div>

    <div class="tbl-footer__right">
        <span class="tbl-footer__range">
            @if (Model.TotalFiltered > 0)
            {
                @($"{rangeStart} - {rangeEnd} / {Model.TotalFiltered:N0} kayıt")
            }
            else
            {
                <text>0 kayıt</text>
            }
        </span>
        <nav class="pagination" aria-label="Sayfalama">
            @{
                var prevOff = Model.PageNumber <= 1 ? "pag-btn--off" : "";
                var nextOff = Model.PageNumber >= Model.TotalPages ? "pag-btn--off" : "";
            }
            <a href="@PageUrl(Model.PageNumber - 1)" class="pag-btn @prevOff" aria-label="Önceki">
                @await Html.PartialAsync("_Icons", "chevron-left")
            </a>
            @{
                const int maxVis = 5;
                int sp = Math.Max(1, Model.PageNumber - maxVis / 2);
                int ep = Math.Min(Model.TotalPages, sp + maxVis - 1);
                if (ep - sp < maxVis - 1) sp = Math.Max(1, ep - maxVis + 1);
            }
            @if (sp > 1)
            {
                <a href="@PageUrl(1)" class="pag-btn">1</a>
                if (sp > 2) { <span class="pag-ellipsis">...</span> }
            }
            @for (int p = sp; p <= ep; p++)
            {
                var active = p == Model.PageNumber ? "pag-btn--active" : "";
                <a href="@PageUrl(p)" class="pag-btn @active">@p</a>
            }
            @if (ep < Model.TotalPages)
            {
                if (ep < Model.TotalPages - 1) { <span class="pag-ellipsis">...</span> }
                <a href="@PageUrl(Model.TotalPages)" class="pag-btn">@Model.TotalPages</a>
            }
            <a href="@PageUrl(Model.PageNumber + 1)" class="pag-btn @nextOff" aria-label="Sonraki">
                @await Html.PartialAsync("_Icons", "chevron-right")
            </a>
        </nav>
    </div>
</div>
