@using System.Text.Json
@using FurkanTural_Admin.Models.Common
@using FurkanTural_Admin.Models.Report
@model ReportIndexViewModel
@{
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var statuses = new[] { "Pending", "Reviewed", "Dismissed", "ActionTaken" };

    string Reason(ReportAdminDto r)
    {
        var c = r.Reason ?? "";
        return c.Length > 50 ? c.Substring(0, 50) + "…" : (c.Length == 0 ? "—" : c);
    }
}

<script id="__report-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-select"><input type="checkbox" class="row-select-all" aria-label="Sayfadaki tüm kayıtları seç" /></th>
                <th class="col-id">ID</th>
                <th>Şikayetçi</th>
                <th>Hedef Kullanıcı</th>
                <th>Tür</th>
                <th>Neden</th>
                <th>Durum</th>
                <th>Tarih</th>
                <th>Silinmiş</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="col-select"><input type="checkbox" class="row-select" value="@row.Id" aria-label="Kaydı seç" /></td>
                    <td>@row.Id</td>
                    <td>@(row.ReporterName ?? $"#{row.ReporterId}")</td>
                    <td>@(row.ReportedUserName ?? (row.ReportedUserId.HasValue ? $"#{row.ReportedUserId}" : "—"))</td>
                    <td>@(row.TargetType ?? "—")</td>
                    <td>@Reason(row)</td>
                    <td>
                        <form class="status-form" method="post" action="@Url.Action("UpdateStatus")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@row.Id" />
                            <select name="status" class="status-sel" data-current="@row.Status" @(row.IsDeleted ? "disabled" : "")>
                                @foreach (var s in statuses)
                                {
                                    <option value="@s" selected="@(row.Status == s)">@s</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td>@row.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="sbadge sbadge--deleted">Evet</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--safe">Hayır</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="row-btn ft-view-btn" title="Görüntüle" data-id="@row.Id">@await Html.PartialAsync("_Icons", "eye")</button>
                            @if (!row.IsDeleted)
                            {
                                if (row.IsActive)
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--warn" title="Pasife Al">@await Html.PartialAsync("_Icons", "toggle-on")</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--success" title="Aktife Al">@await Html.PartialAsync("_Icons", "toggle-off")</button>
                                    </form>
                                }
                            }
                            @if (row.IsDeleted)
                            {
                                <form method="post" action="@Url.Action("Restore")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--restore" title="Geri Yükle">@await Html.PartialAsync("_Icons", "restore")</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row"><td colspan="10">Kayıt bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="bulk-bar" data-bulk-url="@Url.Action("Bulk")" role="region" aria-label="Seçili kayıtlar için toplu işlem" hidden>
    <form class="bulk-bar__token">@Html.AntiForgeryToken()</form>
    <strong class="bulk-bar__count" data-bulk-count>0 seçili</strong>
    <div class="bulk-bar__actions">
        <button type="button" class="btn-outline bulk-bar__btn" data-bulk-action="deactivate">Pasife Al</button>
        <button type="button" class="btn-outline bulk-bar__btn" data-bulk-action="activate">Aktife Al</button>
        <button type="button" class="btn-outline bulk-bar__btn" data-bulk-action="restore">Geri Yükle</button>
        <button type="button" class="btn-outline bulk-bar__btn bulk-bar__btn--quiet" data-bulk-clear>Vazgeç</button>
    </div>
</div>

@await Html.PartialAsync("_TableFooter", new TableFooterModel(
    Model.PageNumber, Model.PageSize, Model.TotalPages, Model.TotalFiltered,
    [
        new("search",        Model.Search),
        new("typeFilter",    Model.TypeFilter),
        new("statusFilter",  Model.StatusFilter),
        new("deletedFilter", Model.DeletedFilter),
        new("dateFrom",      Model.DateFrom),
        new("dateTo",        Model.DateTo),
    ]))
