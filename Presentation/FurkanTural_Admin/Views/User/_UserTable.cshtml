@using FurkanTural_Admin.Models.User
@using FurkanTural_Admin.Models.Common
@using System.Text.Json
@model UserIndexViewModel
@{
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var apiBase = (ViewData["ApiBaseUrl"] as string ?? "").TrimEnd('/');
}

@* Satırlar JSON olarak gömülür; application/json türü tarayıcının bu bloğu betik gibi çalıştırmasını engeller. *@
<script id="__user-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Avatar</th>
                <th class="col-username">Kullanıcı Adı</th>
                <th>E-posta</th>
                <th class="col-role">Rol</th>
                <th>Aktif</th>
                <th>Silinmiş</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Id</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(row.AvatarUrl))
                        {
                            <img src="@(row.AvatarUrl.Contains('/') ? $"{apiBase}/{row.AvatarUrl}" : $"{apiBase}/images/uploads/{row.AvatarUrl}")" alt="avatar" style="width:34px;height:34px;border-radius:50%;object-fit:cover;border:1px solid rgba(128,128,128,.4)" />
                        }
                        else
                        {
                            <span style="width:34px;height:34px;border-radius:50%;display:inline-grid;place-items:center;background:var(--accent-soft);color:var(--accent);font-weight:700;">
                                @((row.DisplayName ?? row.Username ?? "?").Trim().Substring(0, 1).ToUpperInvariant())
                            </span>
                        }
                    </td>
                    <td>@(row.Username ?? "—")</td>
                    <td>@(row.Email ?? "—")</td>
                    <td>@(row.RoleName ?? "—")</td>
                    <td>
                        @if (row.IsActive)
                        {
                            <span class="sbadge sbadge--active">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Aktif
                            </span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--passive">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Pasif
                            </span>
                        }
                    </td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="sbadge sbadge--deleted">Evet</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--safe">Hayır</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <a href="@Url.Action("Index", "Role", new { roleId = row.RoleId })"
                               class="row-btn row-btn--info" title="Rolü Görüntüle">
                                @await Html.PartialAsync("_Icons", "roles")
                            </a>
                            <button type="button" class="row-btn ft-view-btn" title="Görüntüle" data-id="@row.Id">
                                @await Html.PartialAsync("_Icons", "eye")
                            </button>
                            @if (!row.IsDeleted && row.IsActive)
                            {
                                <button type="button" class="row-btn row-btn--edit ft-edit-btn" title="Düzenle" data-id="@row.Id">
                                    @await Html.PartialAsync("_Icons", "pencil")
                                </button>
                                <button type="button" class="row-btn ft-avatar-btn" title="Avatar Yükle" data-id="@row.Id">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
                                </button>
                            }

                            @if (!row.IsDeleted)
                            {
                                if (row.IsActive)
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--warn" title="Pasife Al">
                                            @await Html.PartialAsync("_Icons", "toggle-on")
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--success" title="Aktife Al">
                                            @await Html.PartialAsync("_Icons", "toggle-off")
                                        </button>
                                    </form>
                                }
                            }

                            @if (row.IsDeleted)
                            {
                                <form method="post" action="@Url.Action("Restore")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--restore" title="Geri Yükle">
                                        @await Html.PartialAsync("_Icons", "restore")
                                    </button>
                                </form>
                            }
                            else if (row.IsActive)
                            {
                                <form method="post" action="@Url.Action("Delete")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--delete" title="Sil">
                                        @await Html.PartialAsync("_Icons", "trash")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row">
                    <td colspan="8">Kayıt bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_TableFooter", new TableFooterModel(
    Model.PageNumber, Model.PageSize, Model.TotalPages, Model.TotalFiltered,
    [
        new("searchUsername", Model.SearchUsername),
        new("roleFilter",     Model.RoleFilter),
        new("activeFilter",   Model.ActiveFilter),
        new("deletedFilter",  Model.DeletedFilter),
        new("dateFrom",       Model.DateFrom),
        new("dateTo",         Model.DateTo),
    ]))
