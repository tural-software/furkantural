@using FurkanTural_Admin.Helpers
@{
    var currentSlug = AdminModules.ByController(ViewContext.RouteData.Values["controller"] as string)?.Slug;
}
<div class="ml" id="moduleLauncher" hidden>
    <div class="ml__scrim" data-ml-close></div>
    <div class="ml__panel" role="dialog" aria-modal="true" aria-label="Modüller">
        <div class="ml__head">
            <span class="ml__search-wrap">
                @await Html.PartialAsync("_Icons", "search")
                <input type="search" id="mlSearch" class="ml__search" autocomplete="off" spellcheck="false"
                       placeholder="Modül ara — blog, mesaj, şikayet…" aria-label="Modül ara" />
            </span>
            <button type="button" class="ml__close" data-ml-close>Kapat</button>
        </div>

        <div class="ml__body" id="mlBody">
            @foreach (var group in AdminModules.Grouped())
            {
                <section class="ml__group" data-ml-group>
                    <h3 class="ml__group-title">
                        @group.Key
                        <span class="ml__group-count">@group.Count()</span>
                    </h3>
                    @foreach (var m in group)
                    {
                        <a class="ml__row" href="@Url.Action("Index", m.Controller)"
                           data-ml-row data-ml-text="@($"{m.Title} {m.Slug} {m.CountUnitLabel} {m.Group}")"
                           aria-current="@(m.Slug == currentSlug ? "page" : null)">
                            <span class="ml__row-icon">@await Html.PartialAsync("_Icons", m.Slug)</span>
                            <span class="ml__row-text">
                                <span class="ml__row-title">@m.Title</span>
                                <span class="ml__row-unit">@m.CountUnitLabel</span>
                            </span>
                            <span class="ml__row-arrow">@await Html.PartialAsync("_Icons", "chevron-right")</span>
                        </a>
                    }
                </section>
            }
            <p class="ml__empty" id="mlEmpty" hidden>Eşleşen modül yok.</p>
        </div>
    </div>
</div>
