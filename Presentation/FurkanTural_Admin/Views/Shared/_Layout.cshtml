@{
    var hideChrome = ViewData["HideChrome"] as bool? ?? false;
    var username = Context.Session.GetString("username");
    var pageTitle = ViewData["Title"] as string
                    ?? FurkanTural_Admin.Helpers.AdminModules.ByController(ViewContext.RouteData.Values["controller"] as string)?.Title;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Yönetim paneli — arama motorlarınca indekslenmemeli. *@
    <meta name="robots" content="noindex, nofollow" />
    <title>@pageTitle - FurkanTural Admin</title>

    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/icons/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />

    @* Tema, stil bağlantılarından önce satır içi olarak uygulanır; sonraya kalırsa sayfa bir kare yanlış temayla çizilir. *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var t = (saved === 'light' || saved === 'dark')
                    ? saved
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.dataset.theme = t;
            } catch (_) {
                document.documentElement.dataset.theme = 'dark';
            }
        })();
    </script>

    @* Inter kendi sunucumuzdan (theme.css içindeki @@font-face, wwwroot/fonts). *@
    <link rel="preload" href="~/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/tags.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/section.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/toast.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/list-skeleton.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/entity-card.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/detail-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/form-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/html-preview-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout/chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/module-launcher.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app">
        @if (!hideChrome)
        {
            @await Html.PartialAsync("~/Views/Shared/_LayoutSections/_Header.cshtml", username)
        }
        <main class="main">
            @RenderBody()
        </main>
        @if (!hideChrome)
        {
            @await Html.PartialAsync("~/Views/Shared/_LayoutSections/_Footer.cshtml")
        }
    </div>

    @if (!hideChrome)
    {
        @await Html.PartialAsync("~/Views/Shared/_LayoutSections/_ModuleLauncher.cshtml")
        @await Html.PartialAsync("~/Views/Shared/_LayoutSections/_TabBar.cshtml")
    }

    <div id="toastBox" role="status" aria-live="polite">
        <div id="toastTitle"></div>
        <div id="toastMsg"></div>
    </div>

    @* Tek kaynak ikon sözlüğü — detail-modal.js (ve diğer istemci modülleri) buradan okur.
       IconLibrary tek doğruluk kaynağı; _Icons.cshtml ile aynı SVG'leri paylaşır. *@
    <script>window.__ICONS = @Html.Raw(FurkanTural_Admin.Helpers.IconLibrary.Json);</script>
    <script src="~/js/ft-time.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/toast.js" asp-append-version="true"></script>
    <script src="~/js/reveal.js" asp-append-version="true"></script>
    <script src="~/js/module-launcher.js" asp-append-version="true"></script>
    <script src="~/js/mobile-list.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
