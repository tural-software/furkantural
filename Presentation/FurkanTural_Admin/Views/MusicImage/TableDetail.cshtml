@{
    ViewData["Title"] = "MusicImages Tablosu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/music/music-table-detail.css" asp-append-version="true" />
}

<div class="container">

    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <a href="@Url.Action("Index", "MusicImage")">Müzik Görselleri</a>
        <span class="bc__sep">›</span>
        <span>Tablo Detayları</span>
    </nav>

    <div class="pg-header">
        <div>
            <div class="pg-header__title-row">
                <h1 class="section-title" style="margin:0">MusicImages Tablosu</h1>
                <span class="page-badge">TABLO</span>
            </div>
            <p class="section-desc">Tablo yapısını görüntüleyin ve alan detaylarını inceleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index", "MusicImage")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "arrow-left")
                Verilere Dön
            </a>
        </div>
    </div>

    <div class="schema-stats">
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "database")
            </div>
            <div class="schema-stat__label">Toplam Alan</div>
            <div class="schema-stat__value">12</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "field-key")
            </div>
            <div class="schema-stat__label">Primary Key</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "hash-icon")
            </div>
            <div class="schema-stat__label">Identity</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "link")
            </div>
            <div class="schema-stat__label">Foreign Key</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
    </div>

    <div class="card schema-table-wrap">
        <table class="schema-table">
            <thead>
                <tr>
                    <th>Alan Adı</th>
                    <th>Tip</th>
                    <th>Kısıtlamalar</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><span class="sf sf--pk">Id</span></td>
                    <td><span class="st st--int">int</span></td>
                    <td><span class="sc sc--pk">PK</span> <span class="sc sc--identity">IDENTITY</span></td>
                    <td>Birincil anahtar</td>
                </tr>
                <tr>
                    <td><span class="sf">Url</span></td>
                    <td><span class="st st--str">string?</span></td>
                    <td><span class="sc sc--nullable">NULL</span></td>
                    <td>Görsel dosya adı / URL</td>
                </tr>
                <tr>
                    <td><span class="sf">AltText</span></td>
                    <td><span class="st st--str">string?</span></td>
                    <td><span class="sc sc--nullable">NULL</span> <span class="sc">MAX 500</span></td>
                    <td>Görsel açıklama metni</td>
                </tr>
                <tr>
                    <td><span class="sf">IsCover</span></td>
                    <td><span class="st st--bool">bool</span></td>
                    <td><span class="sc sc--notnull">NOT NULL</span></td>
                    <td>Kapak görseli mi?</td>
                </tr>
                <tr>
                    <td><span class="sf sf--fk">MusicId</span></td>
                    <td><span class="st st--int">int</span></td>
                    <td><span class="sc sc--fk">FK → Musics</span> <span class="sc sc--notnull">NOT NULL</span></td>
                    <td>İlgili müzik kaydı</td>
                </tr>
                <tr>
                    <td><span class="sf">IsActive</span></td>
                    <td><span class="st st--bool">bool</span></td>
                    <td><span class="sc sc--notnull">NOT NULL</span></td>
                    <td>Aktiflik durumu</td>
                </tr>
                <tr>
                    <td><span class="sf">IsDeleted</span></td>
                    <td><span class="st st--bool">bool</span></td>
                    <td><span class="sc sc--notnull">NOT NULL</span></td>
                    <td>Silinme durumu (soft-delete)</td>
                </tr>
                <tr>
                    <td><span class="sf">CreatedAt</span></td>
                    <td><span class="st st--date">DateTime</span></td>
                    <td><span class="sc sc--notnull">NOT NULL</span></td>
                    <td>Oluşturulma tarihi</td>
                </tr>
                <tr>
                    <td><span class="sf">CreatedBy</span></td>
                    <td><span class="st st--int">int?</span></td>
                    <td><span class="sc sc--nullable">NULL</span></td>
                    <td>Oluşturan kullanıcı ID</td>
                </tr>
                <tr>
                    <td><span class="sf">UpdatedAt</span></td>
                    <td><span class="st st--date">DateTime?</span></td>
                    <td><span class="sc sc--nullable">NULL</span></td>
                    <td>Güncellenme tarihi</td>
                </tr>
                <tr>
                    <td><span class="sf">UpdatedBy</span></td>
                    <td><span class="st st--int">int?</span></td>
                    <td><span class="sc sc--nullable">NULL</span></td>
                    <td>Güncelleyen kullanıcı ID</td>
                </tr>
                <tr>
                    <td><span class="sf">DeletedAt</span></td>
                    <td><span class="st st--date">DateTime?</span></td>
                    <td><span class="sc sc--nullable">NULL</span></td>
                    <td>Silinme tarihi</td>
                </tr>
            </tbody>
        </table>
    </div>

</div>
