@using System.Text.Json
@using FurkanTural_Admin.Models.Common
@using FurkanTural_Admin.Models.Status
@model StatusIndexViewModel
@{
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

<script id="__status-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Grup</th>
                <th>Kod</th>
                <th>Ad</th>
                <th>Renk</th>
                <th>Sıra</th>
                <th>Aktif</th>
                <th>Silinmiş</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Id</td>
                    <td>@(row.Group ?? "—")</td>
                    <td>@(row.Code ?? "—")</td>
                    <td>@(row.Name ?? "—")</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(row.Color))
                        {
                            <span style="display:inline-flex;align-items:center;gap:6px;">
                                <span style="width:14px;height:14px;border-radius:4px;display:inline-block;border:1px solid rgba(128,128,128,.4);background:@row.Color"></span>
                                <span>@row.Color</span>
                            </span>
                        }
                        else
                        {
                            <text>—</text>
                        }
                    </td>
                    <td>@row.SortOrder</td>
                    <td>
                        @if (row.IsActive)
                        {
                            <span class="sbadge sbadge--active">@await Html.PartialAsync("_Icons", "check-circle") Aktif</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--passive">@await Html.PartialAsync("_Icons", "x-circle") Pasif</span>
                        }
                    </td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="sbadge sbadge--deleted">Evet</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--safe">Hayır</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="row-btn ft-view-btn" title="Görüntüle" data-id="@row.Id">
                                @await Html.PartialAsync("_Icons", "eye")
                            </button>
                            @if (!row.IsDeleted && row.IsActive)
                            {
                                <button type="button" class="row-btn row-btn--edit ft-edit-btn" title="Düzenle" data-id="@row.Id">
                                    @await Html.PartialAsync("_Icons", "pencil")
                                </button>
                            }
                            @if (!row.IsDeleted)
                            {
                                if (row.IsActive)
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--warn" title="Pasife Al">@await Html.PartialAsync("_Icons", "toggle-on")</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--success" title="Aktife Al">@await Html.PartialAsync("_Icons", "toggle-off")</button>
                                    </form>
                                }
                            }
                            @if (row.IsDeleted)
                            {
                                <form method="post" action="@Url.Action("Restore")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--restore" title="Geri Yükle">@await Html.PartialAsync("_Icons", "restore")</button>
                                </form>
                            }
                            else if (row.IsActive)
                            {
                                <form method="post" action="@Url.Action("Delete")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--delete" title="Sil">@await Html.PartialAsync("_Icons", "trash")</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row"><td colspan="9">Kayıt bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_TableFooter", new TableFooterModel(
    Model.PageNumber, Model.PageSize, Model.TotalPages, Model.TotalFiltered,
    [
        new("name",          Model.SearchName),
        new("groupFilter",   Model.GroupFilter),
        new("activeFilter",  Model.ActiveFilter),
        new("deletedFilter", Model.DeletedFilter),
        new("dateFrom",      Model.DateFrom),
        new("dateTo",        Model.DateTo),
    ]))
