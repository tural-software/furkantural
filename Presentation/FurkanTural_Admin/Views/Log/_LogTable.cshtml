@using FurkanTural_Admin.Models.Log
@using FurkanTural_Admin.Models.Common
@using System.Text.Json
@model LogIndexViewModel
@{
    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@* Satırlar JSON olarak gömülür; application/json türü tarayıcının bu bloğu betik gibi çalıştırmasını engeller. *@
<script id="__log-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Proje</th>
                <th class="col-date">Log Tarihi</th>
                <th>Seviye</th>
                <th class="col-message">Mesaj</th>
                <th>IP Adresi</th>
                <th>Yol</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                var levelCss = row.Level switch
                {
                    "Error"   => "level-badge level-badge--error",
                    "Warning" => "level-badge level-badge--warning",
                    "Info"    => "level-badge level-badge--info",
                    "Debug"   => "level-badge level-badge--debug",
                    _         => "level-badge level-badge--neutral"
                };
                var msgTrunc = row.Message != null && row.Message.Length > 80
                    ? row.Message[..80] + "…"
                    : (row.Message ?? "—");

                <tr>
                    <td>@row.Id</td>
                    <td>@(row.Project ?? "—")</td>
                    <td>@row.Date.ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="@levelCss">@(row.Level ?? "—")</span></td>
                    <td class="col-message" title="@row.Message">@msgTrunc</td>
                    <td>@(row.IpAddress ?? "—")</td>
                    <td>@(row.Path ?? "—")</td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="row-btn ft-view-btn" title="Görüntüle" data-id="@row.Id">
                                @await Html.PartialAsync("_Icons", "eye")
                            </button>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row">
                    <td colspan="8">Kayıt bulunamadı.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_TableFooter", new TableFooterModel(
    Model.PageNumber, Model.PageSize, Model.TotalPages, Model.TotalFiltered,
    [
        new("levelFilter",   Model.LevelFilter),
        new("searchProject", Model.SearchProject),
        new("searchMessage", Model.SearchMessage),
        new("dateFrom",      Model.DateFrom),
        new("dateTo",        Model.DateTo),
    ]))
