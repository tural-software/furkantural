@{
    ViewData["Title"] = "Subscriber Tablosu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/subscriber/subscriber-table-detail.css" asp-append-version="true" />
}

<div class="container">

    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <a href="@Url.Action("Index", "Subscriber")">Aboneler</a>
        <span class="bc__sep">›</span>
        <span>Tablo Detayları</span>
    </nav>

    <div class="pg-header">
        <div>
            <div class="pg-header__title-row">
                <h1 class="section-title" style="margin:0">Subscriber Tablosu</h1>
                <span class="page-badge">TABLO</span>
            </div>
            <p class="section-desc">Tablo yapısını görüntüleyin ve alan detaylarını inceleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index", "Subscriber")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "arrow-left")
                Verilere Dön
            </a>
        </div>
    </div>

    <div class="schema-stats">
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "database")
            </div>
            <div class="schema-stat__label">Toplam Alan</div>
            <div class="schema-stat__value">9</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "field-key")
            </div>
            <div class="schema-stat__label">Primary Key</div>
            <div class="schema-stat__value">2</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "hash-icon")
            </div>
            <div class="schema-stat__label">Identity</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "lock-icon")
            </div>
            <div class="schema-stat__label">Zorunlu Alan</div>
            <div class="schema-stat__value">4</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "circle-outline")
            </div>
            <div class="schema-stat__label">Boş Geçilebilir</div>
            <div class="schema-stat__value">5</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "server-icon")
            </div>
            <div class="schema-stat__label">Tablo Boyutu</div>
            <div class="schema-stat__value">~ 0.8</div>
            <div class="schema-stat__unit">KB tahmini</div>
        </div>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-field">Alan Adı</th>
                        <th>Veri Tipi</th>
                        <th>Maks. Uzunluk (Byte)</th>
                        <th>Boş Geçilebilir</th>
                        <th>Primary Key</th>
                        <th>Identity</th>
                        <th>Varsayılan</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <span class="field-name field-name--pk">
                                @await Html.PartialAsync("_Icons", "field-key")
                                Id
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Benzersiz abone tanımlayıcısı</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--pk">
                                @await Html.PartialAsync("_Icons", "field-key")
                                Email
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>400</td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Abonenin e-posta adresi</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "clock")
                                CreatedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Kaydın oluşturulma tarihi</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "person")
                                CreatedBy
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Kaydı oluşturan kullanıcı ID</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "clock")
                                UpdatedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Kaydın son güncellenme tarihi</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "person")
                                UpdatedBy
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Son güncelleyen kullanıcı ID</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                IsActive
                            </span>
                        </td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>1 (true)</td>
                        <td>Abonenin aktiflik durumu</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                IsDeleted
                            </span>
                        </td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>0 (false)</td>
                        <td>Soft delete durumu</td>
                    </tr>
                    <tr>
                        <td>
                            <span class="field-name field-name--std">
                                @await Html.PartialAsync("_Icons", "clock")
                                DeletedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td>
                            <span class="bool-yes">
                                @await Html.PartialAsync("_Icons", "check-circle")
                                Evet
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>
                            <span class="bool-no">
                                @await Html.PartialAsync("_Icons", "x-circle")
                                Hayır
                            </span>
                        </td>
                        <td>Yok</td>
                        <td>Kaydın silinme tarihi</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="tbl-info-row">
        <div class="card tbl-info-card">
            <div class="tbl-info-card__label">Oluşturulma Bilgisi</div>
            <div class="tbl-info-card__main">
                @await Html.PartialAsync("_Icons", "clock")
                <span class="tbl-info-card__value">Proje kurulumu sırasında</span>
            </div>
            <div class="tbl-info-card__sub">Migration ile oluşturuldu</div>
        </div>
        <div class="card tbl-info-card">
            <div class="tbl-info-card__label">Son Güncelleme</div>
            <div class="tbl-info-card__main">
                @await Html.PartialAsync("_Icons", "clock")
                <span class="tbl-info-card__value">—</span>
            </div>
            <div class="tbl-info-card__sub">Yapısal değişiklik yok</div>
        </div>
        <div class="card tbl-info-card">
            <div class="tbl-info-card__label">Tablo Durumu</div>
            <div class="tbl-info-card__main">
                <span class="tbl-status-badge">
                    <span class="status-dot"></span>
                    Aktif
                </span>
            </div>
            <div class="tbl-info-card__sub" style="padding-left:0">Silinmiş kayıtlar işleniyor (Soft Delete)</div>
        </div>
    </div>

</div>
