@{
    ViewData["Title"] = "İletişim Mesajı Detayı";
}

<div class="container">
    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <a href="@Url.Action("Index")">İletişim Mesajları</a>
        <span class="bc__sep">›</span>
        <span>Tablo Detayları</span>
    </nav>

    <div class="pg-header">
        <div>
            <h1 class="section-title">Tablo Detayları</h1>
            <p class="section-desc">İletişim mesajları tablosunun sütun bilgileri.</p>
        </div>
    </div>

    <div class="card" style="padding:1.5rem">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Alan Adı</th>
                    <th>Tür</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Id</td><td>int</td><td>Birincil anahtar</td></tr>
                <tr><td>Name</td><td>string (200)</td><td>Gönderenin adı</td></tr>
                <tr><td>Email</td><td>string (256)</td><td>Gönderenin e-postası</td></tr>
                <tr><td>Message</td><td>string (2000)</td><td>Mesaj içeriği</td></tr>
                <tr><td>IsRead</td><td>bool</td><td>Okundu mu?</td></tr>
                <tr><td>IpAddress</td><td>string (45)</td><td>Gönderen IP adresi</td></tr>
                <tr><td>UserAgent</td><td>string (512)</td><td>Tarayıcı bilgisi</td></tr>
                <tr><td>IsActive</td><td>bool</td><td>Aktif mi?</td></tr>
                <tr><td>IsDeleted</td><td>bool</td><td>Silinmiş mi?</td></tr>
                <tr><td>CreatedAt</td><td>DateTime</td><td>Oluşturulma tarihi</td></tr>
                <tr><td>DeletedAt</td><td>DateTime?</td><td>Silinme tarihi</td></tr>
            </tbody>
        </table>
    </div>
</div>
