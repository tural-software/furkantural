@{
    ViewData["Title"] = "Musics Tablosu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/music/music-table-detail.css" asp-append-version="true" />
}

<div class="container">

    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <a href="@Url.Action("Index", "Music")">Müzikler</a>
        <span class="bc__sep">›</span>
        <span>Tablo Detayları</span>
    </nav>

    <div class="pg-header">
        <div>
            <div class="pg-header__title-row">
                <h1 class="section-title" style="margin:0">Musics Tablosu</h1>
                <span class="page-badge">TABLO</span>
            </div>
            <p class="section-desc">Tablo yapısını görüntüleyin ve alan detaylarını inceleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index", "Music")" class="btn-outline">
                @await Html.PartialAsync("_Icons", "arrow-left")
                Verilere Dön
            </a>
        </div>
    </div>

    <div class="schema-stats">
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "database")
            </div>
            <div class="schema-stat__label">Toplam Alan</div>
            <div class="schema-stat__value">16</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "field-key")
            </div>
            <div class="schema-stat__label">Primary Key</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "hash-icon")
            </div>
            <div class="schema-stat__label">Identity</div>
            <div class="schema-stat__value">1</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "link")
            </div>
            <div class="schema-stat__label">Foreign Key</div>
            <div class="schema-stat__value">0</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "lock-icon")
            </div>
            <div class="schema-stat__label">Zorunlu Alan</div>
            <div class="schema-stat__value">4</div>
            <div class="schema-stat__unit">alan</div>
        </div>
        <div class="card schema-stat">
            <div class="schema-stat__icon">
                @await Html.PartialAsync("_Icons", "circle-outline")
            </div>
            <div class="schema-stat__label">Boş Geçilebilir</div>
            <div class="schema-stat__value">12</div>
            <div class="schema-stat__unit">alan</div>
        </div>
    </div>

    <div class="card" style="padding: 0; overflow: hidden;">
        <div class="data-table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th class="col-field">Alan Adı</th>
                        <th>Veri Tipi</th>
                        <th>Maks. Uzunluk (Byte)</th>
                        <th>Boş Geçilebilir</th>
                        <th>Primary Key</th>
                        <th>Identity</th>
                        <th>Varsayılan</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @* Id *@
                    <tr>
                        <td>
                            <span class="field-name field-name--pk">
                                @await Html.PartialAsync("_Icons", "field-key")
                                Id
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td>Yok</td>
                        <td>Benzersiz müzik tanımlayıcısı</td>
                    </tr>
                    @* Name *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Name
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>200</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Şarkı adı</td>
                    </tr>
                    @* Artist *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Artist
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>200</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Sanatçı adı</td>
                    </tr>
                    @* Productor *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Productor
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>200</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Prodüktör adı</td>
                    </tr>
                    @* Album *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Album
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>200</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Albüm adı</td>
                    </tr>
                    @* Genre *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Genre
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>200</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Müzik türü</td>
                    </tr>
                    @* Lyrics *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "field-text")
                                Lyrics
                            </span>
                        </td>
                        <td><span class="type-tag">nvarchar</span></td>
                        <td>NULL</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Şarkı sözleri (max uzunluk yok)</td>
                    </tr>
                    @* Duration *@
                    <tr>
                        <td>
                            <span class="field-name field-name--date">
                                @await Html.PartialAsync("_Icons", "clock")
                                Duration
                            </span>
                        </td>
                        <td><span class="type-tag">time</span></td>
                        <td>5</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Şarkı süresi (SS:DD:SN)</td>
                    </tr>
                    @* ReleaseDate *@
                    <tr>
                        <td>
                            <span class="field-name field-name--date">
                                @await Html.PartialAsync("_Icons", "calendar")
                                ReleaseDate
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Yayın tarihi</td>
                    </tr>
                    @* CreatedAt *@
                    <tr>
                        <td>
                            <span class="field-name field-name--date">
                                @await Html.PartialAsync("_Icons", "calendar")
                                CreatedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>GETUTCDATE()</td>
                        <td>Oluşturulma tarihi (UTC)</td>
                    </tr>
                    @* CreatedBy *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "user")
                                CreatedBy
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Kaydı oluşturan admin ID</td>
                    </tr>
                    @* UpdatedAt *@
                    <tr>
                        <td>
                            <span class="field-name field-name--date">
                                @await Html.PartialAsync("_Icons", "calendar")
                                UpdatedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Son güncellenme tarihi (UTC)</td>
                    </tr>
                    @* UpdatedBy *@
                    <tr>
                        <td>
                            <span class="field-name">
                                @await Html.PartialAsync("_Icons", "user")
                                UpdatedBy
                            </span>
                        </td>
                        <td><span class="type-tag">int</span></td>
                        <td>4</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Son güncelleyen admin ID</td>
                    </tr>
                    @* IsActive *@
                    <tr>
                        <td>
                            <span class="field-name field-name--bool">
                                @await Html.PartialAsync("_Icons", "field-bool")
                                IsActive
                            </span>
                        </td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>1</td>
                        <td>Aktiflik bayrağı</td>
                    </tr>
                    @* IsDeleted *@
                    <tr>
                        <td>
                            <span class="field-name field-name--bool">
                                @await Html.PartialAsync("_Icons", "field-bool")
                                IsDeleted
                            </span>
                        </td>
                        <td><span class="type-tag">bit</span></td>
                        <td>1</td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>0</td>
                        <td>Silinme bayrağı (soft delete)</td>
                    </tr>
                    @* DeletedAt *@
                    <tr>
                        <td>
                            <span class="field-name field-name--date">
                                @await Html.PartialAsync("_Icons", "calendar")
                                DeletedAt
                            </span>
                        </td>
                        <td><span class="type-tag">datetime2</span></td>
                        <td>8</td>
                        <td><span class="bool-yes">@await Html.PartialAsync("_Icons", "check-circle") Evet</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td><span class="bool-no">@await Html.PartialAsync("_Icons", "x-circle") Hayır</span></td>
                        <td>NULL</td>
                        <td>Silinme tarihi (UTC)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>
