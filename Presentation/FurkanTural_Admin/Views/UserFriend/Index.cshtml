@using FurkanTural_Admin.Models.UserFriend
@model UserFriendIndexViewModel
@{
    ViewData["Title"] = "Arkadaşlıklar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/user-friend/user-friend-index.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        window.__friendMeta = {
            statusFilter:  '@Html.Raw(Model.StatusFilter ?? "")',
            activeFilter:  '@Html.Raw(Model.ActiveFilter ?? "")',
            deletedFilter: '@Html.Raw(Model.DeletedFilter ?? "")',
            dateFrom:      '@Html.Raw(Model.DateFrom ?? "")',
            dateTo:        '@Html.Raw(Model.DateTo ?? "")',
            pageNumber:    @Model.PageNumber,
            pageSize:      @Model.PageSize
        };
    </script>
    <script src="~/js/detail-modal.js" asp-append-version="true"></script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/js/pages/user-friend-index.js" asp-append-version="true"></script>
}

@Html.AntiForgeryToken()

<div class="container">
    <nav class="bc">
        <a href="@Url.Action("Index", "Dashboard")">Ana Sayfa</a>
        <span class="bc__sep">›</span>
        <span>Arkadaşlıklar</span>
    </nav>

    <div class="pg-header">
        <div>
            <h1 class="section-title">Arkadaşlıklar Verileri</h1>
            <p class="section-desc">Kullanıcı arkadaşlık ilişkilerini görüntüleyin ve denetleyin.</p>
        </div>
        <div class="pg-header__actions">
            <a href="@Url.Action("Index")" class="btn-outline">@await Html.PartialAsync("_Icons", "refresh") Yenile</a>
        </div>
    </div>

    <div class="stats-row">
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--total">@await Html.PartialAsync("_Icons", "friends")</div>
            <div><p class="stat-box__label">Toplam</p><div class="stat-box__value">@Model.TotalCount.ToString("N0")</div><span class="stat-box__unit">ilişki</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--active">@await Html.PartialAsync("_Icons", "check-circle")</div>
            <div><p class="stat-box__label">Aktif</p><div class="stat-box__value">@Model.ActiveCount.ToString("N0")</div><span class="stat-box__unit">ilişki</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--passive">@await Html.PartialAsync("_Icons", "x-circle")</div>
            <div><p class="stat-box__label">Pasif</p><div class="stat-box__value">@Model.PassiveCount.ToString("N0")</div><span class="stat-box__unit">ilişki</span></div>
        </div>
        <div class="card stat-box">
            <div class="stat-box__icon stat-box__icon--deleted">@await Html.PartialAsync("_Icons", "trash")</div>
            <div><p class="stat-box__label">Silinmiş</p><div class="stat-box__value">@Model.DeletedCount.ToString("N0")</div><span class="stat-box__unit">ilişki</span></div>
        </div>
    </div>

    <div class="card" style="padding: 1.25rem; margin-bottom: 1.25rem;">
        <form method="get" action="@Url.Action("Index")">
            <div class="filter-bar">
                <div class="filter-group">
                    <label>Durum (kod)</label>
                    <input type="text" name="statusFilter" value="@Model.StatusFilter" class="filter-input" placeholder="Örn: Accepted" />
                </div>
                <div class="filter-group">
                    <label>Aktiflik Durumu</label>
                    <select name="activeFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.ActiveFilter))">Tümü</option>
                        <option value="active" selected="@(Model.ActiveFilter == "active")">Aktif</option>
                        <option value="passive" selected="@(Model.ActiveFilter == "passive")">Pasif</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Silinme Durumu</label>
                    <select name="deletedFilter" class="filter-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.DeletedFilter))">Tümü</option>
                        <option value="notDeleted" selected="@(Model.DeletedFilter == "notDeleted")">Silinmemiş</option>
                        <option value="deleted" selected="@(Model.DeletedFilter == "deleted")">Silinmiş</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label>Oluşturulma Tarihi</label>
                    <div class="filter-date-row">
                        <input type="date" name="dateFrom" value="@Model.DateFrom" class="filter-input" />
                        <span class="filter-date-sep">→</span>
                        <input type="date" name="dateTo" value="@Model.DateTo" class="filter-input" />
                    </div>
                </div>
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">@await Html.PartialAsync("_Icons", "filter-icon") Filtrele</button>
                    <a href="@Url.Action("Index")" class="btn-outline">@await Html.PartialAsync("_Icons", "x-mark") Temizle</a>
                </div>
            </div>
        </form>
    </div>

    <div class="card" id="friend-table-card" style="padding: 0; overflow: hidden;">
        <div id="friend-table-section">
            @await Html.PartialAsync("_UserFriendTable", Model)
        </div>
    </div>
</div>
