@using System.Text.Json
@using Microsoft.AspNetCore.Html
@using FurkanTural_Admin.Models.UserFriend
@model UserFriendIndexViewModel
@{
    int rangeStart = Model.TotalFiltered > 0 ? (Model.PageNumber - 1) * Model.PageSize + 1 : 0;
    int rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalFiltered);

    string PageUrl(int p) => Url.Action("Index", new
    {
        statusFilter = Model.StatusFilter,
        activeFilter = Model.ActiveFilter,
        deletedFilter = Model.DeletedFilter,
        dateFrom = Model.DateFrom,
        dateTo = Model.DateTo,
        pageNumber = p,
        pageSize = Model.PageSize
    }) ?? "#";

    var jsonOpts = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}

@*
    Kullanıcı hücresi: ad öne çıkar, Id ikincil kalır. Id tamamen atılmıyor çünkü
    admin listesi silinmiş kullanıcıların kayıtlarını da gösterir — o satırlarda ad
    çözülemez ve elde tek tutamak Id olur.
*@
@functions {
    static IHtmlContent UserCell(string? username, int userId)
    {
        var builder = new HtmlContentBuilder();
        if (string.IsNullOrWhiteSpace(username))
        {
            builder.AppendHtml("<span class=\"user-cell__unknown\">Bilinmiyor</span>");
        }
        else
        {
            builder.AppendHtml("<span class=\"user-cell__name\">").Append(username).AppendHtml("</span>");
        }
        builder.AppendHtml("<span class=\"user-cell__id\">#").Append(userId.ToString()).AppendHtml("</span>");
        return builder;
    }
}

<script id="__friend-rows-json" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Rows, jsonOpts))</script>

<div class="data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th class="col-id">ID</th>
                <th>Gönderen</th>
                <th>Alıcı</th>
                <th>Durum</th>
                <th>Yanıt Tarihi</th>
                <th>Aktif</th>
                <th>Silinmiş</th>
                <th class="col-actions">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.Id</td>
                    <td>@UserCell(row.RequesterUsername, row.RequesterId)</td>
                    <td>@UserCell(row.AddresseeUsername, row.AddresseeId)</td>
                    <td>@(row.StatusName ?? row.StatusCode ?? "—")</td>
                    <td>@(row.RespondedAt?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                    <td>
                        @if (row.IsActive)
                        {
                            <span class="sbadge sbadge--active">@await Html.PartialAsync("_Icons", "check-circle") Aktif</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--passive">@await Html.PartialAsync("_Icons", "x-circle") Pasif</span>
                        }
                    </td>
                    <td>
                        @if (row.IsDeleted)
                        {
                            <span class="sbadge sbadge--deleted">Evet</span>
                        }
                        else
                        {
                            <span class="sbadge sbadge--safe">Hayır</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            <button type="button" class="row-btn ft-view-btn" title="Görüntüle" data-id="@row.Id">@await Html.PartialAsync("_Icons", "eye")</button>
                            @if (!row.IsDeleted)
                            {
                                if (row.IsActive)
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--warn" title="Pasife Al">@await Html.PartialAsync("_Icons", "toggle-on")</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" action="@Url.Action("ToggleActive")" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@row.Id" />
                                        <button type="submit" class="row-btn row-btn--success" title="Aktife Al">@await Html.PartialAsync("_Icons", "toggle-off")</button>
                                    </form>
                                }
                            }
                            @if (row.IsDeleted)
                            {
                                <form method="post" action="@Url.Action("Restore")" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <button type="submit" class="row-btn row-btn--restore" title="Geri Yükle">@await Html.PartialAsync("_Icons", "restore")</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr class="empty-row"><td colspan="8">Kayıt bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="tbl-footer">
    <div class="tbl-footer__left">
        <form method="get" action="@Url.Action("Index")" id="pageSizeForm">
            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
            <input type="hidden" name="activeFilter" value="@Model.ActiveFilter" />
            <input type="hidden" name="deletedFilter" value="@Model.DeletedFilter" />
            <input type="hidden" name="dateFrom" value="@Model.DateFrom" />
            <input type="hidden" name="dateTo" value="@Model.DateTo" />
            <input type="hidden" name="pageNumber" value="1" />
            Sayfa başına
            <select name="pageSize" class="page-size-sel" onchange="this.form.submit()">
                @foreach (var s in new[] { 10, 25, 50, 100 })
                {
                    <option value="@s" selected="@(Model.PageSize == s)">@s</option>
                }
            </select>
            kayıt gösteriliyor
        </form>
    </div>
    <div class="tbl-footer__right">
        <span class="tbl-footer__range">
            @if (Model.TotalFiltered > 0)
            {
                @($"{rangeStart} - {rangeEnd} / {Model.TotalFiltered:N0} kayıt")
            }
            else
            {
                <text>0 kayıt</text>
            }
        </span>
        <nav class="pagination" aria-label="Sayfalama">
            @{
                var prevOff = Model.PageNumber <= 1 ? "pag-btn--off" : "";
                var nextOff = Model.PageNumber >= Model.TotalPages ? "pag-btn--off" : "";
            }
            <a href="@PageUrl(Model.PageNumber - 1)" class="pag-btn @prevOff" aria-label="Önceki">@await Html.PartialAsync("_Icons", "chevron-left")</a>
            @{
                const int maxVis = 5;
                int sp = Math.Max(1, Model.PageNumber - maxVis / 2);
                int ep = Math.Min(Model.TotalPages, sp + maxVis - 1);
                if (ep - sp < maxVis - 1) sp = Math.Max(1, ep - maxVis + 1);
            }
            @if (sp > 1)
            {
                <a href="@PageUrl(1)" class="pag-btn">1</a>
                if (sp > 2) { <span class="pag-ellipsis">...</span> }
            }
            @for (var i = sp; i <= ep; i++)
            {
                <a href="@PageUrl(i)" class="pag-btn @(i == Model.PageNumber ? "pag-btn--active" : "")">@i</a>
            }
            @if (ep < Model.TotalPages)
            {
                if (ep < Model.TotalPages - 1) { <span class="pag-ellipsis">...</span> }
                <a href="@PageUrl(Model.TotalPages)" class="pag-btn">@Model.TotalPages</a>
            }
            <a href="@PageUrl(Model.PageNumber + 1)" class="pag-btn @nextOff" aria-label="Sonraki">@await Html.PartialAsync("_Icons", "chevron-right")</a>
        </nav>
    </div>
</div>
