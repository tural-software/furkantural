@model BlogPostViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(Model.Excerpt)
        ? $"{Model.Title} — Furkan Tural Blog"
        : Model.Excerpt;

    ViewData["OgType"] = "article";

    if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        ViewData["OgImage"] = Model.CoverImageUrl;
    }

    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var articleData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = Model.Title,
        ["inLanguage"] = "tr-TR",
        ["mainEntityOfPage"] = canonical,
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = "Furkan Tural"
        },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "Furkan Tural Blog"
        }
    };
    if (!string.IsNullOrEmpty(Model.PublishedIso))
    {
        articleData["datePublished"] = Model.PublishedIso;
        articleData["dateModified"] = Model.ModifiedIso;
    }
    if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        articleData["image"] = Model.CoverImageUrl;
    }
    var articleJsonLd = System.Text.Json.JsonSerializer.Serialize(articleData);

    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var breadcrumbJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Anasayfa", ["item"] = $"{siteUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Model.Title, ["item"] = canonical }
        }
    });
}

<div class="read-progress" role="progressbar" aria-label="Okuma ilerlemesi" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <span class="read-progress__bar" data-read-progress></span>
</div>

<article class="container content-page post-page">
    <nav class="crumb" aria-label="Konum">
        <a asp-controller="Home" asp-action="Index">Blog</a>
        @if (Model.Categories.FirstOrDefault(c => c.Slug.Length > 0) is { } lead)
        {
            <span aria-hidden="true">/</span>
            <a href="@(Url.RouteUrl("BlogCategory", new { slug = lead.Slug }) ?? "/")">@lead.Name</a>
        }
    </nav>

    <h1>@Model.Title</h1>
    <div class="post-meta post-meta--detail">
        @if (!string.IsNullOrEmpty(Model.PublishedDisplay))
        {
            <time datetime="@Model.PublishedIso">@Model.PublishedDisplay</time>
            <span class="post-meta__sep" aria-hidden="true">•</span>
        }
        <span aria-label="@Model.ReadingMinutes dakika okuma">@Model.ReadingMinutes dk okuma</span>
    </div>

    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img class="post-cover reveal" src="@Model.CoverImageUrl" alt="@(Model.CoverAltText ?? Model.Title)" loading="lazy" decoding="async" />
    }

    <div class="post-body">
        <aside class="post-share" aria-label="Bu yazıyı paylaş">
            <div class="post-share__inner">
                <span class="post-share__label">Paylaş</span>
                <button type="button" class="post-share__btn" data-share hidden>Paylaş</button>
                <button type="button" class="post-share__btn" data-copy-link>Bağlantıyı kopyala</button>
            </div>
        </aside>

        <div class="post-content prose reveal" data-read-target>@Model.ContentHtml</div>
    </div>

    @if (Model.Related.Count > 0)
    {
        <aside class="post-related" aria-labelledby="ilgili-baslik">
            <h2 class="post-related__title" id="ilgili-baslik">İlgili yazılar</h2>
            <div class="post-related__grid">
                @foreach (var rel in Model.Related)
                {
                    <a class="related-card" href="@PostUrl.For(Url, rel)">
                        @if (rel.Categories.Count > 0)
                        {
                            <span class="related-card__cats">
                                @foreach (var cat in rel.Categories.Take(2))
                                {
                                    <span class="related-card__cat" style="--chip-color:@cat.DisplayColor">
                                        <span class="post-cat-chip__dot" aria-hidden="true"></span>@cat.Name
                                    </span>
                                }
                            </span>
                        }
                        <span class="related-card__title">@rel.Title</span>
                        <span class="related-card__meta">
                            @if (!string.IsNullOrEmpty(rel.PublishedDisplay))
                            {
                                <time datetime="@rel.PublishedIso">@rel.PublishedDisplay</time>
                                <span aria-hidden="true">·</span>
                            }
                            <span>@rel.ReadingMinutes dk</span>
                        </span>
                    </a>
                }
            </div>
        </aside>
    }

    <footer class="post-foot">
        @if (Model.Categories.Count > 0)
        {
            <div class="index-row__cats">
                @foreach (var cat in Model.Categories.Where(c => c.Slug.Length > 0))
                {
                    <a class="post-cat-chip" style="--chip-color:@cat.DisplayColor"
                       href="@(Url.RouteUrl("BlogCategory", new { slug = cat.Slug }) ?? "/")"
                       aria-label="@cat.Name kategorisindeki yazılar">
                        <span class="post-cat-chip__dot" aria-hidden="true"></span>@cat.Name
                    </a>
                }
            </div>
        }
        @if (Model.Tags.Any(t => t.Slug.Length > 0))
        {
            <div class="post-tags">
                <span class="post-tags__label">Etiketler</span>
                @foreach (var tag in Model.Tags.Where(t => t.Slug.Length > 0))
                {
                    <a class="post-tag-chip"
                       href="@(Url.RouteUrl("BlogTag", new { slug = tag.Slug }) ?? "/")"
                       aria-label="@tag.Name etiketini taşıyan yazılar">#@tag.Name</a>
                }
            </div>
        }
        <a class="back-link" asp-controller="Home" asp-action="Index">Tüm yazılar</a>
    </footer>
</article>

@section HeadMeta {
    @if (!string.IsNullOrEmpty(Model.PublishedIso))
    {
        <meta property="article:published_time" content="@Model.PublishedIso" />
        <meta property="article:modified_time" content="@Model.ModifiedIso" />
    }
    <meta property="article:author" content="Furkan Tural" />
    @foreach (var cat in Model.Categories)
    {
        <meta property="article:tag" content="@cat.Name" />
    }
    @foreach (var tag in Model.Tags)
    {
        <meta property="article:tag" content="@tag.Name" />
    }
}

@section JsonLd {
    @Html.Raw("<script type=\"application/ld+json\">" + articleJsonLd + "</script>")
    @Html.Raw("<script type=\"application/ld+json\">" + breadcrumbJsonLd + "</script>")
}

@section Scripts {
    <script src="~/js/post.js" asp-append-version="true" defer></script>
}
