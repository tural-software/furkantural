@model BlogPostViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(Model.Excerpt)
        ? $"{Model.Title} — Furkan Tural Blog"
        : Model.Excerpt;

    // Kapak varsa sosyal paylaşım kartı (OG/Twitter) bu yazının kapağını kullansın.
    if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        ViewData["OgImage"] = Model.CoverImageUrl;
    }

    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var articleData = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Article",
        ["headline"] = Model.Title,
        ["inLanguage"] = "tr-TR",
        ["mainEntityOfPage"] = canonical,
        ["author"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = "Furkan Tural"
        },
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Organization",
            ["name"] = "Furkan Tural Blog"
        }
    };
    if (!string.IsNullOrEmpty(Model.PublishedIso))
    {
        articleData["datePublished"] = Model.PublishedIso;
    }
    if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        articleData["image"] = Model.CoverImageUrl;
    }
    var articleJsonLd = System.Text.Json.JsonSerializer.Serialize(articleData);

    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var breadcrumbJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = new object[]
        {
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Anasayfa", ["item"] = $"{siteUrl}/" },
            new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Model.Title, ["item"] = canonical }
        }
    });
}

<article class="container content-page">
    <a class="back-link" asp-controller="Home" asp-action="Index">Tüm yazılar</a>
    <h1>@Model.Title</h1>
    <div class="post-meta post-meta--detail">
        @if (!string.IsNullOrEmpty(Model.PublishedDisplay))
        {
            <time datetime="@Model.PublishedIso">@Model.PublishedDisplay</time>
            <span class="post-meta__sep" aria-hidden="true">•</span>
        }
        <span>@Model.ReadingMinutes dk okuma</span>
    </div>
    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
    {
        <img class="post-cover reveal" src="@Model.CoverImageUrl" alt="@(Model.CoverAltText ?? Model.Title)" loading="lazy" decoding="async" />
    }
    <div class="post-content reveal">@Model.Content</div>
</article>

@section JsonLd {
    @Html.Raw("<script type=\"application/ld+json\">" + articleJsonLd + "</script>")
    @Html.Raw("<script type=\"application/ld+json\">" + breadcrumbJsonLd + "</script>")
}
