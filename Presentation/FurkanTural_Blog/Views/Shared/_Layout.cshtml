@{
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var title = ViewData["Title"] as string;
    var pageTitle = string.IsNullOrEmpty(title) ? "Furkan Tural Blog" : $"{title} | Furkan Tural Blog";
    var metaDescription = ViewData["MetaDescription"] as string
        ?? "Furkan Tural'ın yazılım, teknoloji ve geliştirme üzerine notlarını paylaştığı kişisel blog.";
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var ogImage = (ViewData["OgImage"] as string) ?? (siteUrl + "/img/og-image.png");
    // Varsayılan WebSite yapısal verisi; sayfa "JsonLd" section'ı tanımlarsa (örn. yazı için Article) o kullanılır.
    var defaultJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "WebSite",
        ["name"] = "Furkan Tural Blog",
        ["url"] = siteUrl,
        ["description"] = metaDescription,
        ["inLanguage"] = "tr-TR",
        ["publisher"] = new Dictionary<string, object?>
        {
            ["@type"] = "Person",
            ["name"] = "Furkan Tural"
        }
    });
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Scroll-reveal'in boyanmadan önce gizlenebilmesi için .js işaretini erken ekle (FOUC önleme). *@
    <script>document.documentElement.classList.add('js');</script>
    @* Temayı (diğer sitelerle aynı sistem) boyanmadan önce uygula — FOUC ve yanlış-tema yanıp sönmesi önlenir. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@pageTitle</title>
    <meta name="description" content="@metaDescription" />
    <meta name="author" content="Furkan Tural" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href="@canonical" />

    @* PWA — kurulabilir uygulama *@
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="FT Blog" />

    <meta property="og:site_name" content="Furkan Tural Blog" />
    <meta property="og:title" content="@(title ?? "Furkan Tural Blog")" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="@ogImage" />
    <meta name="twitter:title" content="@(title ?? "Furkan Tural Blog")" />
    <meta name="twitter:description" content="@metaDescription" />

    @if (IsSectionDefined("JsonLd"))
    {
        @await RenderSectionAsync("JsonLd")
    }
    else
    {
        @Html.Raw("<script type=\"application/ld+json\">" + defaultJsonLd + "</script>")
    }

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand__mark">FT</span>
                <span class="brand__text">Furkan Tural <span class="brand__sub">Blog</span></span>
            </a>
            <nav class="site-nav" aria-label="Ana menü">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Anasayfa</a>
                <a class="nav-link" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
                <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="Temayı değiştir">
                    <span data-theme-icon aria-hidden="true">🌙</span>
                    <span class="toggle-text">Tema</span>
                </button>
            </nav>
        </div>
    </header>

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <span>&copy; @DateTime.UtcNow.Year Furkan Tural. Tüm hakları saklıdır.</span>
            <a asp-controller="Home" asp-action="Privacy">Gizlilik Politikası</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/reveal.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
