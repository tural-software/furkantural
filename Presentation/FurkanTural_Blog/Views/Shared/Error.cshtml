@model ErrorViewModel
@{
    var is404 = Model.IsNotFound;
    ViewData["Title"] = is404 ? "Sayfa bulunamadı" : "Bir hata oluştu";
    ViewData["MetaDescription"] = is404
        ? "Aradığınız sayfa bulunamadı."
        : "İstek işlenirken bir hata oluştu.";
}

<section class="container content-page error-page">
    <p class="error-page__code">@(is404 ? "404" : "Hata")</p>
    <h1>@(is404 ? "Sayfa bulunamadı" : "Bir şeyler ters gitti")</h1>
    <p>
        @(is404
            ? "Aradığınız sayfa taşınmış, kaldırılmış veya hiç var olmamış olabilir."
            : "İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.")
    </p>
    @if (is404)
    {
        <form class="blog-search error-page__search" method="get" action="@(Url.RouteUrl("BlogSearch") ?? "/ara")" role="search">
            <input class="blog-search__input" type="search" name="q" placeholder="Yazılarda ara…" aria-label="Yazılarda ara" />
            <button class="blog-search__btn" type="submit">Ara</button>
        </form>
    }

    <div class="error-page__actions">
        <a class="btn btn--primary" asp-controller="Home" asp-action="Index">Anasayfaya dön</a>
        @if (is404)
        {
            <a class="btn btn--ghost" href="@(Url.RouteUrl("BlogAbout") ?? "/hakkinda")">Hakkında</a>
        }
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="error-page__req"><small>İstek No: <code>@Model.RequestId</code></small></p>
    }
</section>
