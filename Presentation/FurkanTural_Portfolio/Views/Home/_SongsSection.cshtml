@model IReadOnlyList<SongViewModel>
<section class="section reveal songs-section" id="music">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@SharedLocalizer["Songs_Eyebrow"]</span>
            <h2 class="section-title">@SharedLocalizer["Songs_Title"]</h2>
            <p class="section-desc">@SharedLocalizer["Songs_Desc"]</p>
        </div>

        @* 3D müzik visualizer — portfolio-3d.js bu canvas'a bağlanır (#ftMusic). *@
        <canvas id="ftMusic" class="music-visualizer" aria-hidden="true"></canvas>

        @if (Model != null && Model.Count > 0)
        {
            <div class="songs-list">
                @foreach (var song in Model)
                {
                    var songMeta = string.Join(" • ", new[]
                    {
                        song.Artist,
                        song.Album,
                        song.ReleaseDate?.Year.ToString()
                    }.Where(s => !string.IsNullOrWhiteSpace(s)));
                    <div class="song-card">
                        <div class="song-card__main">
                            <span class="song-card__icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
                            </span>
                            <div class="song-card__info">
                            <a class="song-card__name song-card__link" href="@Url.Action("Detail", "Music", new { id = song.Id })">@song.Name</a>
                            @if (!string.IsNullOrWhiteSpace(songMeta) || !string.IsNullOrWhiteSpace(song.Genre))
                            {
                                <span class="song-card__sub">
                                    @if (!string.IsNullOrWhiteSpace(songMeta))
                                    {
                                        <span class="song-card__meta">@songMeta</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(song.Genre))
                                    {
                                        <span class="song-card__genre">@song.Genre</span>
                                    }
                                </span>
                            }
                            </div>
                        </div>
                        @if (song.Duration.HasValue)
                        {
                            <span class="song-card__duration" aria-label="Süre: @song.Duration.Value.ToString(@"mm\:ss")">@song.Duration.Value.ToString(@"mm\:ss")</span>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <p class="section-empty">@SharedLocalizer["Songs_Empty"]</p>
        }
    </div>
</section>
