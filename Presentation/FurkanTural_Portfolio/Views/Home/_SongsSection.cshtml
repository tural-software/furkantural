@model IReadOnlyList<SongViewModel>
<section class="section songs-section" id="music">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@L["Songs_Eyebrow"]</span>
            <h2 class="section-title">@L["Songs_Title"]</h2>
            <p class="section-desc">@L["Songs_Desc"]</p>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <div class="songs-list">
                @foreach (var song in Model)
                {
                    <div class="song-card">
                        <div class="song-card__info">
                            <span class="song-card__name">@song.Name</span>
                            @if (!string.IsNullOrWhiteSpace(song.Genre))
                            {
                                <span class="song-card__genre">@song.Genre</span>
                            }
                        </div>
                        @if (song.Duration.HasValue)
                        {
                            <span class="song-card__duration">@song.Duration.Value.ToString(@"mm\:ss")</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
