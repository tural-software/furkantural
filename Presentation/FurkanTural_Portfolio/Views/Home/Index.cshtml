@model IndexViewModel
@{
    ViewData["Title"] = "Furkan Tural";
}

@await Html.PartialAsync("_HeroSection")
@await Html.PartialAsync("_AboutSection")
@await Html.PartialAsync("_SkillsSection", Model.Skills)
@await Html.PartialAsync("_ExperienceSection", Model.Experiences)
@await Html.PartialAsync("_EducationSection", Model.Educations)
@await Html.PartialAsync("_ProjectsSection", Model.Projects)
@await Html.PartialAsync("_SongsSection", Model.Songs)
@await Html.PartialAsync("_PricingSection")
@await Html.PartialAsync("_ContactSection")

@section Scripts {
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        window.portfolioConfig = {
            turnstileSiteKey: '@Html.Raw(ViewBag.TurnstileSiteKey ?? "")'
        };
    </script>
    <script src="~/js/hero-three.js" asp-append-version="true" defer></script>
}
