@model IndexViewModel
@await Html.PartialAsync("_HeroSection")
@await Html.PartialAsync("_AboutSection", Model)
@await Html.PartialAsync("_SkillsSection", Model.Skills)
@* Deneyim + Eğitim yan yana (timeline-2col rhythm); mobilde tek sütuna iner. *@
<div class="timeline-2col">
    @await Html.PartialAsync("_ExperienceSection", Model.Experiences)
    @await Html.PartialAsync("_EducationSection", Model.Educations)
</div>
@await Html.PartialAsync("_ProjectsSection", Model.Projects)
@await Html.PartialAsync("_SongsSection", Model.Songs)
@await Html.PartialAsync("_ServicesSection")
@await Html.PartialAsync("_ContactSection")

@section Scripts {
    @* Turnstile site key _ContactSection.cshtml'de data-sitekey ile sunucu-tarafı render edilir;
       api.js widget'ı otomatik render eder (explicit render gerekmez). *@
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
