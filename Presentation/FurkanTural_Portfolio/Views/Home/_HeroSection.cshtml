<section class="hero" id="hero">
    <div class="hero-container">
        <div class="hero-content">
            <p class="hero-greeting">@L["Hero_Greeting"]</p>
            <h1 class="hero-name">@L["Hero_Name"]</h1>
            <p class="hero-tagline">@L["Hero_Tagline"]</p>
            <div class="hero-actions">
                <a href="#projects" class="btn btn-primary">@L["Hero_CTA_Work"]</a>
                <a href="#contact" class="btn btn-outline">@L["Hero_CTA_Contact"]</a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="hero-avatar">
                <img src="~/img/avatar.webp" alt="Furkan Tural" width="320" height="320" loading="eager" onerror="this.style.display='none'" />
            </div>
        </div>
    </div>
</section>
