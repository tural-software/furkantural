@model IReadOnlyList<ProjectViewModel>
<section class="section projects-section" id="projects">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@L["Projects_Eyebrow"]</span>
            <h2 class="section-title">@L["Projects_Title"]</h2>
            <p class="section-desc">@L["Projects_Desc"]</p>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <div class="projects-grid">
                @foreach (var project in Model)
                {
                    <div class="project-card">
                        <div class="project-card__body">
                            <h3 class="project-card__title">@project.Title</h3>
                            <p class="project-card__desc">@project.ShortDescription</p>
                            @if (!string.IsNullOrWhiteSpace(project.TechStack))
                            {
                                <div class="project-card__tags">
                                    @foreach (var tag in project.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="tag">@tag.Trim()</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="project-card__footer">
                            @if (!string.IsNullOrWhiteSpace(project.DemoUrl))
                            {
                                <a href="@project.DemoUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">@L["Project_View_Demo"]</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                            {
                                <a href="@project.GitHubUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline">@L["Project_View_Source"]</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
