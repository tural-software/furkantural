@model IReadOnlyList<ProjectViewModel>
<section class="section reveal projects-section" id="projects">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@SharedLocalizer["Projects_Eyebrow"]</span>
            <h2 class="section-title">@SharedLocalizer["Projects_Title"]</h2>
            <p class="section-desc">@SharedLocalizer["Projects_Desc"]</p>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <div class="projects-grid" data-collapse="row">
                @foreach (var project in Model)
                {
                    <div class="project-card" data-tilt="1">
                        <div class="project-card__body">
                            <span class="project-card__status @(project.IsCompleted ? "is-done" : "is-progress")">
                                @(project.IsCompleted ? SharedLocalizer["Project_Status_Completed"] : SharedLocalizer["Project_Status_InProgress"])
                            </span>
                            <h3 class="project-card__title">
                                <a class="project-card__link" href="@Url.Action("Detail", "Projects", new { id = project.Id })">@project.Title</a>
                            </h3>
                            <p class="project-card__desc">@project.ShortDescription</p>
                            @if (!string.IsNullOrWhiteSpace(project.TechStack))
                            {
                                <div class="project-card__tags">
                                    @foreach (var tag in project.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="tag">@tag.Trim()</span>
                                    }
                                </div>
                            }
                        </div>
                        <div class="project-card__footer">
                            <a href="@Url.Action("Detail", "Projects", new { id = project.Id })" class="btn btn-sm btn-primary"
                               aria-label="@project.Title projesinin detaylarını gör">Detayları Gör →</a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="section-empty">@SharedLocalizer["Projects_Empty"]</p>
        }
    </div>
</section>
