@model IReadOnlyList<SkillViewModel>
@* Skills — çubuk yerine KATEGORİ etiketleri (handoff). DİNAMİK: @Model üzerinden.
   ŞEMASIZ gruplama: SkillViewModel.Category alanı OLMADAN, mevcut Proficiency'ye
   göre seviye bucket'ına grupla (model/DB değişmez). Seviye adları SharedLocalizer'dan
   (Step 1'de standartlaştırıldı: Uzman/İleri/Orta/Başlangıç). *@
<section class="section reveal skills-section" id="skills">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@SharedLocalizer["Skills_Eyebrow"]</span>
            <h2 class="section-title">@SharedLocalizer["Skills_Title"]</h2>
            <p class="section-desc">@SharedLocalizer["Skills_Desc"]</p>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <div class="skills-grid">
                @foreach (var group in Model
                    .GroupBy(s => s.Proficiency >= 91 ? SharedLocalizer["Skill_Level_Expert"].Value
                                : s.Proficiency >= 76 ? SharedLocalizer["Skill_Level_Advanced"].Value
                                : s.Proficiency >= 51 ? SharedLocalizer["Skill_Level_Intermediate"].Value
                                : SharedLocalizer["Skill_Level_Beginner"].Value)
                    .OrderByDescending(g => g.Max(s => s.Proficiency)))
                {
                    <div class="skill-group" data-tilt="1">
                        <div class="skill-group__title">
                            <span class="skill-group__dot" aria-hidden="true"></span>
                            @group.Key
                        </div>
                        <div class="skill-chips">
                            @foreach (var skill in group.OrderByDescending(s => s.Proficiency))
                            {
                                <span class="skill-chip">@skill.Name</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="section-empty">@SharedLocalizer["Skills_Empty"]</p>
        }
    </div>
</section>
