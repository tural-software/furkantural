@model IReadOnlyList<SkillViewModel>
<section class="section reveal skills-section" id="skills">
    <div class="section-container">
        <div class="section-header">
            <span class="section-eyebrow">@SharedLocalizer["Skills_Eyebrow"]</span>
            <h2 class="section-title">@SharedLocalizer["Skills_Title"]</h2>
            <p class="section-desc">@SharedLocalizer["Skills_Desc"]</p>
        </div>
        @if (Model != null && Model.Count > 0)
        {
            <div class="skills-grid">
                @foreach (var skill in Model)
                {
                    var level = skill.Proficiency >= 91 ? SharedLocalizer["Skill_Level_Expert"].Value
                              : skill.Proficiency >= 76 ? SharedLocalizer["Skill_Level_Advanced"].Value
                              : skill.Proficiency >= 51 ? SharedLocalizer["Skill_Level_Intermediate"].Value
                              : SharedLocalizer["Skill_Level_Beginner"].Value;
                    <div class="skill-card">
                        <div class="skill-card__header">
                            <span class="skill-card__name">@skill.Name</span>
                            <span class="skill-card__level">@level</span>
                        </div>
                        <div class="skill-bar">
                            <div class="skill-bar__fill" style="width: @skill.Proficiency%"></div>
                        </div>
                        <span class="skill-card__pct">@skill.Proficiency%</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="section-empty">@SharedLocalizer["Skills_Empty"]</p>
        }
    </div>
</section>
