@{
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var siteUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var seoTitle = (ViewData["Title"] as string) ?? "Furkan Tural";
    var seoDescription = (ViewData["MetaDescription"] as string) ?? SharedLocalizer["Seo_Description"].Value;
    var ogImage = (ViewData["OgImage"] as string) ?? (siteUrl + "/img/og-image.png");
    var ogType = (ViewData["OgType"] as string) ?? "website";
    var personJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Person",
        ["name"] = "Furkan Tural",
        ["url"] = siteUrl,
        ["jobTitle"] = "Full-stack Geliştirici",
        ["description"] = seoDescription
    });
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Scroll-reveal'in boyanmadan önce gizlenebilmesi için .js işaretini erken ekle (FOUC önleme). *@
    <script>document.documentElement.classList.add('js');</script>
    @* Temayı (Admin ile aynı sistem) boyanmadan önce uygula — FOUC ve yanlış-tema yanıp sönmesi önlenir. *@
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " | Furkan Tural" : "Furkan Tural")</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? SharedLocalizer["Seo_Description"])" />
    <meta name="author" content="Furkan Tural" />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href="@canonical" />

    @* PWA — kurulabilir uygulama *@
    <link rel="manifest" href="~/site.webmanifest" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="FT Portföy" />
    <meta property="og:site_name" content="Furkan Tural" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Furkan Tural")" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? SharedLocalizer["Seo_Description"])" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@seoTitle" />
    <meta name="twitter:description" content="@seoDescription" />
    <meta name="twitter:image" content="@ogImage" />
    @Html.Raw("<script type=\"application/ld+json\">" + personJsonLd + "</script>")
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    @* Tüm-sayfa dekoratif 3D arkaplan (içeriğin arkasında, etkileşimsiz). *@
    <canvas id="canvas-container" aria-hidden="true"></canvas>
    <nav class="navbar" id="navbar" aria-label="Ana navigasyon">
        <div class="nav-container">
            <a class="nav-brand" asp-controller="Home" asp-action="Index" aria-label="Furkan Tural">
                <img class="nav-brand__logo nav-brand__logo--dark" src="~/img/furkan-tural-wordmark-dark.png" alt="" width="148" height="40" />
                <img class="nav-brand__logo nav-brand__logo--light" src="~/img/furkan-tural-wordmark-light.png" alt="" width="148" height="40" />
            </a>
            <div class="nav-links" id="navLinks">
                <a class="nav-link" href="#about">@SharedLocalizer["Nav_About"]</a>
                <a class="nav-link" href="#skills">@SharedLocalizer["Nav_Skills"]</a>
                <a class="nav-link" href="#experience">@SharedLocalizer["Nav_Experience"]</a>
                <a class="nav-link" href="#education">@SharedLocalizer["Nav_Education"]</a>
                <a class="nav-link" href="#projects">@SharedLocalizer["Nav_Projects"]</a>
                <a class="nav-link" href="#music">@SharedLocalizer["Nav_Music"]</a>
                <a class="nav-link" href="#pricing">@SharedLocalizer["Nav_Pricing"]</a>
                <a class="nav-link" href="#contact">@SharedLocalizer["Nav_Contact"]</a>
            </div>
            <div class="nav-actions">
                <button type="button" class="theme-toggle-btn" data-theme-toggle aria-label="@SharedLocalizer["Theme_Toggle_Dark"]">
                    <span data-theme-icon aria-hidden="true">🌙</span>
                    <span class="toggle-text">@SharedLocalizer["Nav_Theme"]</span>
                </button>
                <button class="nav-toggle" id="navToggle" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </nav>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-container">
            <p>&copy; @FurkanTural_Portfolio.Helpers.TimeHelper.NowIstanbul.Year Furkan Tural. Tüm hakları saklıdır.</p>
        </div>
    </footer>

    <div class="consent-banner" id="consentBanner" style="display:none">
        <p>@SharedLocalizer["Consent_Message"]</p>
        <div class="consent-actions">
            <button class="btn-consent-accept" id="consentAccept">@SharedLocalizer["Consent_Accept"]</button>
            <button class="btn-consent-decline" id="consentDecline">@SharedLocalizer["Consent_Decline"]</button>
        </div>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true"></script>
    <script src="~/js/reveal.js" asp-append-version="true" defer></script>
    <script src="~/js/background-three.js" asp-append-version="true" defer></script>
    <script src="~/js/portfolio-3d.js" asp-append-version="true" defer></script>
    <script src="~/js/lightbox.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

