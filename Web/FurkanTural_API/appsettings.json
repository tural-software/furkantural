{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "NNNN:base64:NNNN"
  },
  "JwtSettings": {
    "Secret": "NNNN:base64:NNNN",
    "Issuer": "FurkanTural",
    "Audience": "FurkanTuralClient",
    "ExpiryMinutes": "60"
  },
  "EncryptionSettings": {
    "Key": "CHANGE_ME_32_BYTE_AES_KEY_HERE!!",
    "IV": "CHANGE_IV_16BYTE"
  },
  "BaseImageUrl": "https://localhost:7000",
  "AppTokens": {
    "ExpiryDays": 365,
    "Apps": [
      { "AppName": "Blog",      "AppKey": "CHANGE_ME_BLOG_APP_KEY" },
      { "AppName": "Portfolio", "AppKey": "CHANGE_ME_PORTFOLIO_APP_KEY" }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:3000" ]
  },
  "Swagger": {
    "Enabled": false
  }
}
