<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS WebDAV modülü PUT/DELETE/PATCH fiillerini, istek ASP.NET Core'a (ANCM/aspNetCore handler)
  ulaşmadan ÖNCE ele geçirip "405 - HTTP verb used to access this page is not allowed" döndürür.
  Bu API REST olduğundan (PUT=güncelle, DELETE=sil, PATCH=toggle/restore) WebDAV kaldırılmalıdır;
  aksi halde GET/POST çalışır ama güncelleme/silme/aktiflik işlemleri 405 alır.

  Bu dosya PROJEDE tutulur: `dotnet publish` mevcut web.config'i algılar ve ANCM ayarlarını
  (aspNetCore handler + <aspNetCore> elementi, doğru processPath/arguments/hostingModel ile)
  buna ENJEKTE EDER. Böylece WebDAV kaldırma her publish'te korunur. (Sorunun kök nedeni:
  publish, sunucudaki elle düzenlenmiş web.config'i taze üretimle eziyordu → WebDAV geri geliyordu.)

  Yayın sonrası DOĞRULA: yayınlanan web.config hem aşağıdaki WebDAVModule remove'unu hem de
  <add name="aspNetCore" ... /> handler'ını içermeli.
-->
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
