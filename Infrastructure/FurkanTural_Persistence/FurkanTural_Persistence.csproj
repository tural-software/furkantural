<Project Sdk="Microsoft.NET.Sdk">
  <!-- Metadata -->
  <PropertyGroup>
    <Product>FurkanTural.Persistence</Product>
    <Description>Database CRUD operations for Furkan Tural's projects.</Description>
  </PropertyGroup>

  <!-- Assembly information -->
  <PropertyGroup>
    <AssemblyTitle>FurkanTural.Persistence</AssemblyTitle>
    <AssemblyDescription>A persistence library for Furkan Tural's projects.</AssemblyDescription>
  </PropertyGroup>

  <!-- Versioning -->
  <PropertyGroup>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Kodda KULLANILMAZ; yalnızca güvenlik pinlemesi içindir.
      Zincir: EntityFrameworkCore.Design -> CodeAnalysis.Workspaces.MSBuild -> Microsoft.Build.Tasks.Core
              -> System.Security.Cryptography.Xml 9.0.0 (6 adet "yüksek" advisory, NU1903).
      Design paketi PrivateAssets=all olduğundan açık runtime çıktısına düşmez; yine de restore
      grafiğini temiz tutmak ve NU1903'ü kapatmak için yamalı sürüme pinliyoruz (doğrudan
      referans transitive sürümü ezer).
      Bakım notu: EFCore.Design/MSBuild sürümü yükseltildiğinde transitive sürüm yamalıya
      çıkmış olabilir; o zaman bu satır silinebilir (silip `dotnet build` ile NU1903 kontrol et).
    -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\Core\FurkanTural_Domain\FurkanTural_Domain.csproj" />
    <ProjectReference Include="..\..\Signature\FurkanTural_Application\FurkanTural_Application.csproj" />
  </ItemGroup>
</Project>
